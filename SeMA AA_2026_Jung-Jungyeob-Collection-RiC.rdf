  <rdf:Description rdf:about="urn:sema:ontology:isAccumulationDateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrganicProvenanceDateOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasAccumulationDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Date"/>
    <rdfs:range rdf:nodeID="Nc4a5cceaa3184391a588abdf8d8d6425"/>
    <owl:propertyChainAxiom rdf:nodeID="N91d7ea467dd84109873b72348ff19a94"/>
    <rdfs:comment xml:lang="en">Connects a Date to a Record Resource or Instantiation that was or
         will be accumulated at this Date.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es fecha de acumulación de</rdfs:label>
    <rdfs:label xml:lang="fr">est la date d'accumulation de</rdfs:label>
    <rdfs:label xml:lang="en">is accumulation date of</rdfs:label>
    <skos:changeNote rdf:nodeID="Nf139b07fe5d04221abaaae79c1b01fef"/>
    <skos:changeNote rdf:nodeID="Nd7460d13dbbd48348fff7e6196e5734c"/>
    <skos:changeNote rdf:nodeID="Nd1fe9890889a4318a39220d6d749c0bb"/>
    <skos:scopeNote xml:lang="en">When used for a Record Set (e.g. a file), it is the accumulation
         date of the Record Set itself rather than the accumulation date of the members of the
         Record Set. To record the accumulation date of members of the Record Set, use 'is or was
         accumulation date of all members of', 'is or was accumulation date of most members of’ or
         'is or was accumulation date of some members of’.</skos:scopeNote>
  </rdf:Description>
