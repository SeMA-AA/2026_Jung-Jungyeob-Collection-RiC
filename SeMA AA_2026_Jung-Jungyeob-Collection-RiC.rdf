  <rdf:Description rdf:about="urn:sema:ontology:migratedInto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadDerivedInstantiation"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:migratedFrom"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <owl:propertyChainAxiom rdf:nodeID="N5d7f35967ed94a379eac2226103d9230"/>
    <rdfs:comment xml:lang="en">Connects an Instantiation to a version it has been migrated
         into.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a été migrée vers</rdfs:label>
    <rdfs:label xml:lang="es">migrado a</rdfs:label>
    <rdfs:label xml:lang="en">migrated into</rdfs:label>
    <skos:changeNote rdf:nodeID="N0b5c16e7554344719f55447944b834fe"/>
    <skos:changeNote rdf:nodeID="N16e28455689b44a78f792fd249e00747"/>
    <skos:changeNote rdf:nodeID="Nf501262e00844e7089bc3f9ccdfaf0ab"/>
    <skos:changeNote rdf:nodeID="Nfab9e4626ecb4139ba3732a51fa8f00e"/>
    <skos:changeNote rdf:nodeID="N0ee6e3a425644aa58b278fee25c2c3f2"/>
    <skos:changeNote rdf:nodeID="N0c47888f2839440c98e175b853aefc2a"/>
