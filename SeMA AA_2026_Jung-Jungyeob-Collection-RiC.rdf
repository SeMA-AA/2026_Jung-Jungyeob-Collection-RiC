    <skos:changeNote rdf:nodeID="Naaac406d3e59463e8ca3806c7f235d3f"/>
    <skos:changeNote rdf:nodeID="Nf782f427cc8b4d00b6d8152c2d134631"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the GroupSubdivisionRelation class. It
         should be used only when you have to manage instances of the GroupSubdivisionRelation
         class, to connect each instance to itself, in order to be able to infer, using OWL-RL and
         property paths, the two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:isConstituentOfTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrWasConstituentOf"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isPartOfTransitive"/>
