  <rdf:Description rdf:about="urn:sema:ontology:usedToDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:endDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Appellation"/>
