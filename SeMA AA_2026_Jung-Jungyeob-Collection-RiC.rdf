    <rdfs:label xml:lang="es">Tipo de soporte</rdfs:label>
    <rdfs:label xml:lang="fr">Type de support</rdfs:label>
    <skos:changeNote rdf:nodeID="N03a5b218ce2e4f96b9751cffd3a6d0a2"/>
    <skos:changeNote rdf:nodeID="N90f7773db00d45b38f26b4a85751475f"/>
