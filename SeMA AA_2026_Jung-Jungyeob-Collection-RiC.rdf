  <rdf:Description rdf:about="urn:sema:ontology:agentTemporalRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:temporalRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:AgentTemporalRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:AgentTemporalRelation"/>
    <rdfs:comment xml:lang="en">Connects an AgentTemporalRelation to itself. It is a property that
         can stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation temporelle entre agents</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación temporal entre
         agentes</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Agent Temporal Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Nf72f3cabaabc46538a3f07bba4a5f021"/>
    <skos:changeNote rdf:nodeID="N495ca44c11684a1ba6f339e581cfdf93"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the AgentTemporalRelation class. It
         should be used only when you have to manage instances of the AgentTemporalRelation class,
         to connect each instance to itself, in order to be able to infer, using OWL-RL and property
         paths, the two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
