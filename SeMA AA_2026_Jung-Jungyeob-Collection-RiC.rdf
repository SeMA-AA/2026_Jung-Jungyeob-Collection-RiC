    <skos:changeNote rdf:nodeID="Nca22d5b773334b4297aa390a5ee3b85f"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:DateType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Type"/>
    <rdfs:comment xml:lang="en">Categorization of a Date.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Date Type</rdfs:label>
    <rdfs:label xml:lang="de">Datumskategorie</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de fecha</rdfs:label>
    <rdfs:label xml:lang="fr">Type de date</rdfs:label>
    <skos:changeNote rdf:nodeID="N332e04a656e84d3db10b889fc924b461"/>
    <skos:changeNote rdf:nodeID="Nb2c0e7d62b0e4f2c9d46c537a95ffbf4"/>
    <skos:changeNote rdf:nodeID="Ndb03ce30a29446c99264e79b6e4655b5"/>
    <skos:changeNote rdf:nodeID="N140baf0384434586988614d07132c879"/>
    <skos:scopeNote xml:lang="en">May be used to categorize a Date as a single date, a date range
         or a date set or sub-categories of these broad types. This attribute should not be confused
         with the date relations defined to connect a Date entity and any other entity (such as
         RiC-R069 ‘is beginning date of’).</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-A42 (Date Type attribute) (new
         in RiC-CM 1.0).</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N417635f0fa394314804fac4cf6340826">
