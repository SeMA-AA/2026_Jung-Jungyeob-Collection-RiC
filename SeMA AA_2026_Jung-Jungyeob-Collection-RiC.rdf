    <rdfs:range rdf:resource="urn:sema:ontology:Relation"/>
    <rdfs:comment xml:lang="en">Connects a Relation to itself. It is a property that can stand for
         an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Ne3546467a9984e0392add49fbe916751"/>
    <skos:changeNote rdf:nodeID="N588afe51f9004d0c9879821c7c91b60d"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the generic Relation class. It should
         be used only when you have to manage instances of this Relation class, to connect each
         instance to itself, in order to be able to infer, using OWL-RL and property paths, the two
         shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
