    <rdfs:range rdf:resource="urn:sema:ontology:AgentName"/>
    <rdfs:comment xml:lang="en">Connects an Agent and (one of) its present or past Agent
         Name.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour nom d’agent</rdfs:label>
    <rdfs:label xml:lang="en">has or had agent name</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como nombre de agente</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd4e0842cc0e74757bb2ff10dcc01cb9b"/>
    <skos:changeNote rdf:nodeID="N19306e33fc7540fa93f7282f48164bc4"/>
    <skos:changeNote rdf:nodeID="N3d843d89ccd04a1582ff105e9387d13c"/>
  </rdf:Description>
