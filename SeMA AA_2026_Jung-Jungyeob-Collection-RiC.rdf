    <skos:changeNote rdf:nodeID="N0935230993854878a9c7b1af31af7ba0"/>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R060 and RiC-R060i
         relations</RiCCMCorrespondingComponent>
