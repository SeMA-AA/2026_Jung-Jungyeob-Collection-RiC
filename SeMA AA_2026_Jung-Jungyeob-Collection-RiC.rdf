    <rdfs:comment xml:lang="en">Connects a Person to an educational institution at which they
         studied or study. Both 'institution' and 'at' can be interpreted broadly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
