  <rdf:Description rdf:nodeID="Nf44c922fde8040909d70b91e3bdf7e1f">
    <dc:date>2024-08-02</dc:date>
    <rdf:value xml:lang="en">Removed global reflexivity (leads to
               inconsistency).</rdf:value>
  </rdf:Description>
