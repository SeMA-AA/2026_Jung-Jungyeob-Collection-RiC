    <rdfs:subClassOf rdf:nodeID="N7e898b2d19cd44c8b900038380013e29"/>
    <rdfs:comment xml:lang="en">Connects at least one Person to at least another Person, when the
         first has/have descendant the second one(s). The Relation is oriented from the ascendant to
         the descendant: the ascendant Person(s) is the source of the Relation, and the descendant
         Person(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Descendance Relation</rdfs:label>
    <rdfs:label xml:lang="de">Person-Nachkommen</rdfs:label>
    <rdfs:label xml:lang="es">Relación de descendencia</rdfs:label>
    <rdfs:label xml:lang="fr">Relation de descendance</rdfs:label>
