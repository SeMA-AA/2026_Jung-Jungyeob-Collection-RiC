  <rdf:Description rdf:about="urn:sema:ontology:PlaceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Type"/>
    <rdfs:comment xml:lang="en">Categorization of a Place.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="de">Geografikumskategorie</rdfs:label>
    <rdfs:label xml:lang="en">Place Type</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de lugar</rdfs:label>
    <rdfs:label xml:lang="fr">Type de lieu</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd57afdce4c714ce49929b9e6abe31a9a"/>
    <skos:changeNote rdf:nodeID="Nf222b22756c14496b46f626f4c7cdc00"/>
    <skos:changeNote rdf:nodeID="Ne993572bab6345128d99d6a6f58d9b49"/>
    <skos:changeNote rdf:nodeID="N5157cfbb468d4167acb65dea1e0aef27"/>
    <skos:scopeNote xml:lang="en">Broadly, a Place may be a member of three broad categories:
         jurisdiction, manmade structure, or a natural feature. Each of these three categories can
         subdivided into narrower categories.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-A32 (Place Type
         attribute)</RiCCMCorrespondingComponent>
  </rdf:Description>
