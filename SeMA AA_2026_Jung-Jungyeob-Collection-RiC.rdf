  <rdf:Description rdf:about="urn:sema:ontology:geographicalCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment xml:lang="en">Longitudinal and latitudinal information about a Place. </rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">coordenadas geográficas</rdfs:label>
    <rdfs:label xml:lang="fr">coordonnées géographiques</rdfs:label>
    <rdfs:label xml:lang="en">geographical coordinates</rdfs:label>
    <skos:changeNote rdf:nodeID="Nfed8bfc7d65b4091a5cd6489294728e6"/>
    <skos:changeNote rdf:nodeID="N9b8f189b6b59480f91741fdc993828a7"/>
    <skos:changeNote rdf:nodeID="N4dbeff2cb18640e2b5db7eedba2f25c4"/>
    <skos:changeNote rdf:nodeID="Nf8e720a03c8a41309ae98a9fd64b6e45"/>
    <skos:changeNote rdf:nodeID="Nee55a309cea2490bac1d520f9e017007"/>
    <skos:example xml:lang="en">Latitude 35.89421911, Longitude 139.94637467 (ISO
         6709/F)</skos:example>
    <skos:example xml:lang="en">Latitude 50°40′46,461″N, Longitude 95°48′26,533″W, Height 123,45m
         (ISO 6709/D)</skos:example>
    <skos:scopeNote xml:lang="en">Provided for usability reasons. May be deprecated and removed
         later on. Use only if you don't use PhysicalLocation and Coordinates classes with Place.
         Coordinates may be based on ISO 6709 Standard representation of geographic point location
         by coordinates.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-A11 (Coordinates
         attribute)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:entersOrEnteredIntoAgreementWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">enters or entered into agreement with</rdfs:label>
    <rdfs:domain rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
