  <rdf:Description rdf:about="urn:sema:ontology:AuthorityRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nb47f0088b1b64788a5476a7b6ead48ce"/>
