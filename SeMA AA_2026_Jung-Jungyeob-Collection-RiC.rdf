    <rdfs:comment xml:lang="en">Inverse of 'is directly included in proxy' object
         property.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">proxy directly includes</rdfs:label>
    <rdfs:label xml:lang="fr">proxy inclut directement</rdfs:label>
    <rdfs:label xml:lang="es">proxy incluye directamente</rdfs:label>
    <skos:changeNote rdf:nodeID="N3f1d7d9193284a5db5f79d296cc93769"/>
    <skos:changeNote rdf:nodeID="N08998f812e004ef3b2c22d6365a243a8"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:usedFromDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:beginningDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Appellation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment xml:lang="en">Date at which an Appellation was first used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">usado desde la fecha</rdfs:label>
    <rdfs:label xml:lang="en">used from date</rdfs:label>
    <rdfs:label xml:lang="fr">utilisé à partir de</rdfs:label>
    <skos:changeNote rdf:nodeID="N133df3fe451a4674948e7e3d0f307a14"/>
    <skos:changeNote rdf:nodeID="N4544e1d49cd64ff5a5518b64b1813529"/>
    <skos:changeNote rdf:nodeID="Na1da5fbfc35b4f2ca97aead85c800c3c"/>
    <skos:scopeNote xml:lang="en">Provided for usability reasons. May be deprecated and removed
         later on. Use only if you don't use Date classes for handling dates.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Datatype property specialized implementation of
         RiC-E18 (Date entity)</RiCCMCorrespondingComponent>
  </rdf:Description>
