  <rdf:Description rdf:about="urn:sema:ontology:knowingOfRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:KnowingOfRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:KnowingOfRelation"/>
    <rdfs:comment xml:lang="en">Connects a KnowingOfRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation de connaissance à propos d’une
         personne</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación de conocimieto indirecto entre
         personas</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Knowing Of Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="N7390900ec0374a998c75a582fb3f6e5f"/>
    <skos:changeNote rdf:nodeID="N18fd65d8a81d4649aa31fa21bdf82025"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the KnowingOfRelation class. It should
         be used only when you have to manage instances of the KnowingOfRelation class, to connect
         each instance to itself, in order to be able to infer, using OWL-RL and property paths, the
         two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3f01f2df6e3d4572b0dc5e088d595080">
