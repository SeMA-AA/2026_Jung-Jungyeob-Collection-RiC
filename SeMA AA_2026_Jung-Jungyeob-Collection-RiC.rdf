  <rdf:Description rdf:about="urn:sema:resource:entity-028">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:CorporateBody"/>
    <rdfs:label xml:lang="ko">박물관과</rdfs:label>
    <identifier>sample-entity-028</identifier>
    <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6114203</identifier>
    <name xml:lang="ko">박물관과</name>
    <type xml:lang="ko">서울시 부서</type>
