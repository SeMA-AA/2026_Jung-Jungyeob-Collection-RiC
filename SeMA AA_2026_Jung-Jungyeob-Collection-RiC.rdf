  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:precedesInSequenceTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:precedesOrPreceded"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:followsInSequenceTransitive"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <owl:propertyChainAxiom rdf:nodeID="N9dc1693b7a9f4babb9a7e82955e6acbe"/>
    <rdfs:comment xml:lang="en">Connects a Thing to a Thing that follows it directly or indirectly
         in some sequence (not necessarily defined or characterised chronologically). This is a
         transitive relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">précède dans la séquence transitif</rdfs:label>
    <rdfs:label xml:lang="es">precede secuencialmente a transitivo</rdfs:label>
    <rdfs:label xml:lang="en">precedes in sequence transitive</rdfs:label>
    <skos:changeNote rdf:nodeID="N699d540e0863438c85a7d55e7d5d5dba"/>
    <skos:changeNote rdf:nodeID="Ne89129220a4f4b859b1079e37e585542"/>
    <skos:changeNote rdf:nodeID="N500aeeec08944fba9bced4252ea5b71c"/>
    <skos:changeNote rdf:nodeID="N07623b55a63f4b1a894d0c99dc28655f"/>
    <skos:changeNote rdf:nodeID="N14e8371a2861466eb30f6caae0d8be45"/>
  </rdf:Description>
