  <rdf:Description rdf:about="urn:sema:resource:entity-009">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:label xml:lang="ko">1995년 「여성작가 정정엽 첫 개인전」 『한겨레신문』 실물</rdfs:label>
    <identifier>sample-entity-009</identifier>
    <identifier>MA-02-00004287</identifier>
    <name xml:lang="ko">1995년 「여성작가 정정엽 첫 개인전」 『한겨레신문』 실물</name>
    <name xml:lang="ko">신문기사 스크랩 실물</name>
    <type xml:lang="ko">인스턴스</type>
    <isOrWasInstantiationOf rdf:resource="urn:sema:resource:entity-003"/>
    <generalDescription xml:lang="ko">「여성작가 정정엽 첫 개인전」 기사가 수록된 『한겨레 신문』의 기사 스크랩 실물이다.</generalDescription>
    <carrierExtent xml:lang="ko">문서 1쪽, 25.5×35.5cm</carrierExtent>
    <hasCarrierType xml:lang="ko">물리적</hasCarrierType>
    <conditionsOfAccess xml:lang="ko">공개</conditionsOfAccess>
    <conditionsOfUse xml:lang="ko">「서울시립 미술아카이브 공개 및 열람 규정」에 따라 열람이 가능하다.</conditionsOfUse>
    <history xml:lang="ko">2018년 8월부터 2019년 2월까지 수행된 평창동 미술문화복합공간 아트아카이브 2차수집 사업에서 수집되어 아트아카이브 관리시스템에 등록되었다.</history>
    <instantiationExtent xml:lang="ko">신문 1면 중 일부 기사 영역</instantiationExtent>
    <physicalCharacteristicsNote xml:lang="ko">신문기사를 보관한 종이 스크랩이다.</physicalCharacteristicsNote>
    <structure xml:lang="ko">보존상자 '3-R-0015'에 담겨 3층 서고의 ①-A 서가 3단(002-001-3)에 배치되어 있다.</structure>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8f0bf9d8458f4012a8618d21504da94c">
    <dc:date>2023-11-08</dc:date>
    <rdf:value xml:lang="en">In order to get a system of rolified Relation classes: modified
               the property chain axiom so that it now involves the new positionHoldingRelation_role
               object property.</rdf:value>
