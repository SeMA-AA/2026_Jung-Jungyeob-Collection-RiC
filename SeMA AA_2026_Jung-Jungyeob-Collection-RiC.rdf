  <rdf:Description rdf:about="urn:sema:ontology:FamilyRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N2e8edf970d05445caf83bb3ec0ab0695"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentToAgentRelation"/>
    <rdfs:subClassOf rdf:nodeID="Ne32be788225a4ee793af54df6a8788d6"/>
    <rdfs:comment xml:lang="en">Connects at least two Persons, when they have some family link,
         i.e. belong to the same family. This Relation is a generic, not oriented
         one.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
