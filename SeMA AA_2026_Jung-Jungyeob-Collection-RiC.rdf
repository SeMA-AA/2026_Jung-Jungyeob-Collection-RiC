  <rdf:Description rdf:about="urn:sema:ontology:agentHierarchicalRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:AgentHierarchicalRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:AgentHierarchicalRelation"/>
    <rdfs:comment xml:lang="en">Connects an AgentHierarchicalRelation to itself. It is a property
         that can stand for an instance of the class when necessary, e.g. when you explore a
         knowledge graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation hiérarchique entre agents</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación jerárquica entre
         agentes</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Agent Hierarchical Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Ndf82e47c12a64d13bd49d7e7c8ac34ae"/>
    <skos:changeNote rdf:nodeID="N771b3afffd9e43e68a35896345fd5766"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the AgentHierarchicalRelation class. It
         should be used only when you have to manage instances of the AgentHierarchicalRelation
         class, to connect each instance to itself, in order to be able to infer, using OWL-RL and
         property paths, the two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
