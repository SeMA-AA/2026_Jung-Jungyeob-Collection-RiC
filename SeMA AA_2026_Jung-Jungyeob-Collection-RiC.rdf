  <rdf:Description rdf:about="urn:sema:ontology:WholePartRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N4d8afbfe798747a6a61c472ff2615514"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Relation"/>
    <rdfs:subClassOf rdf:nodeID="N38af4b2997af442590cd2447a3b95ee9"/>
    <rdfs:subClassOf rdf:nodeID="N01ca8a37111548b48b429327395ed6da"/>
    <rdfs:comment xml:lang="en">Connects a Thing to at least one other Thing that is or was a
         portion or division of the whole Thing. The Relation is oriented from the Thing to its
         part(s): the Thing is the source of the Relation, and the part Thing(s) is the
         target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">Relación entre todo y parte</rdfs:label>
    <rdfs:label xml:lang="fr">Relation partitive</rdfs:label>
    <rdfs:label xml:lang="de">Teil-Ganzes-Beziehung</rdfs:label>
    <rdfs:label xml:lang="en">Whole Part Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd4539edd0ca646b1ad1e8e04a9bd143c"/>
    <skos:changeNote rdf:nodeID="N10b0ab267fea4f34ace0be726f3f86b3"/>
