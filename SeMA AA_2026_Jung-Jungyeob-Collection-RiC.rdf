  <rdf:Description rdf:about="urn:sema:resource:entity-051">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:CorporateBody"/>
    <rdfs:label xml:lang="ko">총무과</rdfs:label>
    <identifier>sample-entity-051</identifier>
    <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6112474</identifier>
    <name xml:lang="ko">총무과</name>
    <type xml:lang="ko">미술관 부서</type>
    <generalDescription xml:lang="ko">미술아카이브 업무이관 당시 서울시립미술관 소속 총괄 인수부서이다.</generalDescription>
    <history xml:lang="ko">서울시립미술관 본관 경영지원부 산하의 부서이다.</history>
    <hasOrHadLanguage xml:lang="ko">한국어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">지방자치단체 행정기구</hasOrHadLegalStatus>
    <hasOrHadCorporateBodyType xml:lang="ko">공공</hasOrHadCorporateBodyType>
  </rdf:Description>
