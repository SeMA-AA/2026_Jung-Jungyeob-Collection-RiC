    <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6114313</identifier>
    <name xml:lang="ko">미술아카이브과</name>
    <type xml:lang="ko">미술관 부서</type>
    <organizesOrOrganized rdf:resource="urn:sema:resource:entity-035"/>
    <entersOrEnteredIntoAgreementWith rdf:resource="urn:sema:resource:entity-015"/>
