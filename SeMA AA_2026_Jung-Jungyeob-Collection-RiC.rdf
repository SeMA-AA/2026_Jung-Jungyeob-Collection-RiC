  <rdf:Description rdf:about="urn:sema:ontology:hasSubordinateTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadSubordinate"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isSubordinateToTransitive"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Agent"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Agent"/>
    <rdfs:comment xml:lang="en">Connects an Agent to an Agent that is directly or indirectly
         hierarchically inferior. This is a transitive relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a pour subalterne transitif</rdfs:label>
    <rdfs:label xml:lang="en">has subordinate transitive</rdfs:label>
    <rdfs:label xml:lang="es">tiene como subordinado o subordinada a transitivo</rdfs:label>
    <skos:changeNote rdf:nodeID="Nb24a2301f1714565b5b483d14143d5d1"/>
    <skos:changeNote rdf:nodeID="N8c5dcc3dce164fe3b98ae6ae6164cf95"/>
