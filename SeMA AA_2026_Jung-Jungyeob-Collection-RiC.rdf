  <rdf:Description rdf:about="urn:sema:ontology:ChildRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N2fd26c79bec3441793f9769d9a824c22"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:DescendanceRelation"/>
    <rdfs:subClassOf rdf:nodeID="N022a552f99694a89aa074a18e4dc54da"/>
    <rdfs:subClassOf rdf:nodeID="N4fb24761f7be42aa883685e04a5b9059"/>
    <rdfs:comment xml:lang="en">Connects at least one Person to at least another Person, when the
         first has(ave) child(s) the second one(s). The Relation is oriented from the parent to the
         child: the parent is the source of the relation, and the child(ren) is the
         target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Child Relation</rdfs:label>
    <rdfs:label xml:lang="de">Person-Kind</rdfs:label>
    <rdfs:label xml:lang="es">Relación de filiación</rdfs:label>
    <rdfs:label xml:lang="fr">Relation de filiation</rdfs:label>
    <skos:changeNote rdf:nodeID="N1336b6c3478a4f488297ed047dd40397"/>
    <skos:changeNote rdf:nodeID="N0f017bcba4ff4bfb9271da1f909c2f76"/>
