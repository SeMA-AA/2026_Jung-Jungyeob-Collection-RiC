  <rdf:Description rdf:about="urn:sema:ontology:CarrierExtent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Extent"/>
    <rdfs:comment xml:lang="en">Number of physical units and/or physical dimensions of the carrier
         of an Instantiation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Carrier Extent</rdfs:label>
    <rdfs:label xml:lang="de">Datenträgerumfang</rdfs:label>
    <rdfs:label xml:lang="es">Extensión del soporte</rdfs:label>
    <rdfs:label xml:lang="fr">Mesure d’un support</rdfs:label>
    <skos:changeNote rdf:nodeID="N159f665526eb4110b8c8a80ab6fed3f8"/>
    <skos:changeNote rdf:nodeID="N7133e8d467fd4069895f3290f0a33ae9"/>
    <skos:changeNote rdf:nodeID="N4b2d581d1054437b85281f188dec6f54"/>
    <skos:changeNote rdf:nodeID="N84f94e795730474a90c4a5a52c7e251a"/>
    <skos:changeNote rdf:nodeID="N15681e4090af423d888a21aace274a61"/>
    <skos:changeNote rdf:nodeID="N666faf4da02944d88f7979cb2f266528"/>
    <skos:scopeNote xml:lang="en">In order to manage an instantiation of a record resource it is
         necessary to note the extent of the carrier as well as that of the instantiation itself.
         Whether it is necessary to note dimensions, the number of relevant units or both depends on
         the nature of the carrier and particular business needs.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-A04 (Carrier Extent)
         attribute</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Naa13ca36f2c546fdae254bf6afbd9c6c">
    <dc:date>2023-11-27</dc:date>
    <rdf:value xml:lang="en">Added a new rdfs:label in Spanish.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadAnalogueInstantiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadInstantiation"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasAnalogueInstantiationOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordResource"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:comment xml:lang="en">Connects a record resource to one of its analogue instantiations,
         whether it exists or has been lost or destroyed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour instanciation analogique</rdfs:label>
    <rdfs:label xml:lang="en">has or had analogue instantiation</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como instanciación analogica</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd35dc99a10cf4c279d9c107f76b47b3a"/>
    <skos:changeNote rdf:nodeID="N4c96e52932fc4f148c74b432c23df93b"/>
    <skos:scopeNote xml:lang="en">In some situations, it may be useful or necessary to connect a
         record resource to an analogue instantiation that no longer exists or has been
         lost.</skos:scopeNote>
  </rdf:Description>
