  <rdf:Description rdf:about="urn:sema:resource:entity-003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:Record"/>
    <rdfs:label xml:lang="ko">(MA-02-00004287)1995년 「여성작가 정정엽 첫 개인전」 『한겨레신문』</rdfs:label>
    <identifier>sample-entity-003</identifier>
    <identifier>MA-02-00004287</identifier>
    <name xml:lang="ko">(MA-02-00004287)1995년 「여성작가 정정엽 첫 개인전」 『한겨레신문』</name>
    <name xml:lang="ko">1995년 「여성작가 정정엽 첫 개인전」 『한겨레신문』</name>
    <type xml:lang="ko">예술자료</type>
    <isOrWasPartOf rdf:resource="urn:sema:resource:entity-002"/>
    <hasOrHadInstantiation rdf:resource="urn:sema:resource:entity-009"/>
    <generalDescription xml:lang="ko">1995년 11월 28일 『한겨레 신문』에 실린 「여성작가 정정엽 첫 개인전」 기사 스크랩이다.</generalDescription>
    <authenticityNote xml:lang="ko">아트아카이브 관리시스템 내 등록 및 관리되고 있다.</authenticityNote>
    <classification xml:lang="ko">상위계층: 정정엽 컬렉션 &gt; 참여 전시 자료 &gt; 개인전 &gt; 《생명을 아우르는 살림》(1995)</classification>
    <conditionsOfAccess xml:lang="ko">공개</conditionsOfAccess>
    <conditionsOfUse xml:lang="ko">「서울시립 미술아카이브 공개 및 열람 규정」에 따라 열람이 가능하다.</conditionsOfUse>
    <isContentTypeOf xml:lang="ko">문서</isContentTypeOf>
    <history xml:lang="ko">2018년 8월부터 2019년 2월까지 수행된 평창동 미술문화복합공간 아트아카이브 2차수집 사업에서 수집되어 아트아카이브 관리시스템에 등록되었다.</history>
    <integrityNote xml:lang="ko">아트아카이브 관리시스템 내 감사증적을 통해 유지되고 있다.</integrityNote>
    <hasOrHadLanguage xml:lang="ko">한국어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">예술자료</hasOrHadLegalStatus>
    <recordResourceExtent xml:lang="ko">문서 1쪽, 25.5*35.5cm</recordResourceExtent>
    <scopeAndContent xml:lang="ko">1995년 11월 28일 『한겨레 신문』에 실린 「여성작가 정정엽 첫 개인전」 기사 스크랩이다. 11월29일부터 12월5일까지 21세기 화랑에서 열리는 《정정엽 첫 개인전》은 '살림'을 주제로 〈곡식〉, 〈김장〉, 〈봄나물〉 등이 전시된다고 소개하며, 도판으로 정정엽 작 〈밥상〉을 게재하였다.</scopeAndContent>
    <hasRecordState xml:lang="ko">원본</hasRecordState>
    <structure xml:lang="ko">보존상자 '3-R-0015'에 담겨 3층 서고의 ①-A 서가 3단(002-001-3)에 배치되어 있다.</structure>
    <hasDocumentaryFormType xml:lang="ko">스크랩</hasDocumentaryFormType>
  </rdf:Description>
