    <skos:changeNote rdf:nodeID="N48a027ce83f34fd6a8e53decb97b0812"/>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R066 ('is or was enforced by'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
