    <identifier>sample-entity-012</identifier>
    <identifier>D0000045986488</identifier>
    <name xml:lang="ko">시립 미술아카이브 이관계획 전자파일</name>
    <type xml:lang="ko">인스턴스</type>
    <isOrWasInstantiationOf rdf:resource="urn:sema:resource:entity-006"/>
    <generalDescription xml:lang="ko">서울시 업무관리시스템에서 생산된 전자문서 파일이다.</generalDescription>
    <authenticityNote xml:lang="ko">원본 전자파일이다.</authenticityNote>
    <hasCarrierType xml:lang="ko">디지털</hasCarrierType>
    <conditionsOfAccess xml:lang="ko">정보공개법 제9조 1항 5호에 따라 부분공개</conditionsOfAccess>
    <conditionsOfUse xml:lang="ko">CC BY-ND 3.0(저작자표시-변경금지 3.0 Unported)</conditionsOfUse>
    <instantiationExtent xml:lang="ko">151.08 KB(결재문서 본문)</instantiationExtent>
    <structure xml:lang="ko">결재문서 본문 1개와 붙임 파일 1개로 구성되어 있다.</structure>
  </rdf:Description>
