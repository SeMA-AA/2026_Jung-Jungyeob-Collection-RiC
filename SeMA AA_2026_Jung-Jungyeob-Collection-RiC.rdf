  <rdf:Description rdf:about="urn:sema:ontology:ActivityType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Type"/>
    <rdfs:comment xml:lang="en">Categorization of an Activity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Activity Type</rdfs:label>
    <rdfs:label xml:lang="de">Aktivitätskategorie</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de actividad</rdfs:label>
    <rdfs:label xml:lang="fr">Type d’activité</rdfs:label>
    <skos:changeNote rdf:nodeID="Nfdca9f15b02f4e08b49400fa348f9237"/>
    <skos:changeNote rdf:nodeID="N96d54de47e06419a93467e1787378faf"/>
    <skos:changeNote rdf:nodeID="Ndb6c78bf1de647a085c27ccf64165bd9"/>
    <skos:changeNote rdf:nodeID="N03e1348fa9454ce1813f5af8cbe04ec6"/>
    <skos:changeNote rdf:nodeID="Nd9a601fe23954d15ad162f5a1fc5f687"/>
    <skos:scopeNote xml:lang="en">Can be extended with any number of subclasses, e.g.
         “function/action” and “activity domain”. This allows for a faceted approach that enables an
         Activity to be categorized using a combination of components, general or more specific. For
         example, “monitoring” can be used in combination with “election polls” or “water
         resources”.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-A02 (Activity Type
         attribute)</RiCCMCorrespondingComponent>
  </rdf:Description>
