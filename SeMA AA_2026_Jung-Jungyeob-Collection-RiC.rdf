    <rdfs:comment xml:lang="en">Connects at least one Record Resource or Instantiation to at least
         one Activity, when the Record Resource or Instantiation results from the Activity. The
         Record Resource(s) or Instantiation(s) is the source of the Relation, and the
         Activity(-ies) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
