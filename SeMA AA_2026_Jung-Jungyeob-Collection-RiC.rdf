  <rdf:Description rdf:about="urn:sema:ontology:proxyIsIncludedInProxyTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isPartOfTransitive"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:proxyIncludesProxyTransitive"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Proxy"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Proxy"/>
    <rdfs:comment xml:lang="en">Connects a Proxy of a Record or Record Set to a Proxy of a Record
         Set which it is included in, directly or indirectly. This is a transitive
         relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">proxy está incluido en el proxy (transitivo)</rdfs:label>
    <rdfs:label xml:lang="fr">proxy est inclus dans le proxy (transitif)</rdfs:label>
    <rdfs:label xml:lang="en">proxy is included in proxy transitive</rdfs:label>
    <skos:changeNote rdf:nodeID="Nae68558d697d421ba1281d7dc54ee1e4"/>
    <skos:changeNote rdf:nodeID="Nd4606bf6230a4c8b998ddb7837baad48"/>
  </rdf:Description>
