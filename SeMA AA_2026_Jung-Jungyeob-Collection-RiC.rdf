  <rdf:Description rdf:nodeID="N1e3cac514dfd4631ba038f883e9d1d1a">
    <dc:date>2023-11-02</dc:date>
    <rdf:value xml:lang="en">Added a new rdfs:label in Spanish.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf7b1dbbd1051479991c145fbb171adf3">
    <dc:date>2023-10-10</dc:date>
    <rdf:value xml:lang="en">Made this property a subproperty of
               isCreationDateOfSomeMembersOf.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5fb4041f54eb4fbc88d591169318700e">
    <rdf:first rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdf:rest rdf:nodeID="N36eea92575ba4a16b9e7187288cb86ad"/>
