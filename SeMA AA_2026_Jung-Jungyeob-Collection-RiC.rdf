    <rdfs:label xml:lang="en">has or had leader</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como líder a</rdfs:label>
    <skos:changeNote rdf:nodeID="N43de00af58e3415389a027c61e43acb3"/>
    <skos:changeNote rdf:nodeID="Nac3446610ce74cf0bb1dade8b0f8e7eb"/>
    <skos:changeNote rdf:nodeID="N04061f477f8a419fad73c179fc1e1fee"/>
    <skos:changeNote rdf:nodeID="Nb805a5da8c144fd0a2f9f3dbd7bddb22"/>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R042i ('has or had leader'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neec9bfd8fd3a4c4b98f9ea46e128b14f">
    <dc:date>2025-02-19</dc:date>
    <rdf:value xml:lang="en">Changed definition (added "or will be").</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N55effa6d4e5b4e69bbf3171ec328aef8">
    <dc:date>2023-11-08</dc:date>
    <rdf:value xml:lang="en">In order to get a system of rolified Relation classes: modified
               the property chain axiom so that it now involves the new leadershipRelation_role
               object property.</rdf:value>
