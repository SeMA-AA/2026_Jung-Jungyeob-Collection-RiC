    <rdfs:subClassOf rdf:nodeID="N3d63d25862ec41ae89de8ae7da94263b"/>
    <rdfs:subClassOf rdf:nodeID="Nad2e7788ffc64358bd72c2b68252caa3"/>
    <rdfs:comment xml:lang="en">Connects at least one Agent and at least one Thing over which the
         Agent has or had some authority. The Agent(s) is the source of the relation, and the
         Thing(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="de">Akteur-Autorität-Ding</rdfs:label>
    <rdfs:label xml:lang="en">Authority Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación de control por parte de agentes</rdfs:label>
    <rdfs:label xml:lang="fr">Relation d’autorité</rdfs:label>
    <skos:changeNote rdf:nodeID="N3fcccfbd18554ffa9d10e7653ef7e815"/>
    <skos:changeNote rdf:nodeID="N19319f3839254a9398b0da2056e370e9"/>
    <skos:changeNote rdf:nodeID="Nfd3622956459468c9ffed58fe19f5ede"/>
    <skos:changeNote rdf:nodeID="N6d3638044b4f4620b5f01ae64bb34b2f"/>
    <skos:changeNote rdf:nodeID="Nd3d9cf98b73f4bc7ab944c75eff5e132"/>
    <skos:changeNote rdf:nodeID="N7b32135459534cc28b10f9b89f4f533b"/>
    <skos:scopeNote xml:lang="en">Use only if it is not possible to specify a narrower authority
         relation, for example OwnershipRelation.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R036 and RiC-R036i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
