  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadPhysicalLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isPlaceAssociatedWith"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasPhysicalLocationOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:range rdf:resource="urn:sema:ontology:PhysicalLocation"/>
    <rdfs:comment xml:lang="en">Connects a Place to one of its past or present Physical
         Location.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour localisation physique</rdfs:label>
    <rdfs:label xml:lang="en">has or had physical location</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como localización física</rdfs:label>
