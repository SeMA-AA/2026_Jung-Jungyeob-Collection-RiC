    <owl:propertyChainAxiom rdf:nodeID="N3543ae6453d545faa0093ab96c9d091a"/>
    <rdfs:comment xml:lang="en">Connects a Group, Person or Position to a Thing that this Agent
         owns or owned.</rdfs:comment>
