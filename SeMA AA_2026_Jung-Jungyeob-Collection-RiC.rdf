  <rdf:Description rdf:about="urn:sema:ontology:knows">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAgentAssociatedWithAgent"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Person"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Person"/>
    <owl:propertyChainAxiom rdf:nodeID="N5839aa03f8f14ea092ccfb2f83d588e8"/>
    <rdfs:comment xml:lang="en">Connects two Persons that directly know each other during their
         existence. This relation is symmetric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">connaît</rdfs:label>
    <rdfs:label xml:lang="es">conoce a</rdfs:label>
    <rdfs:label xml:lang="en">knows</rdfs:label>
    <skos:changeNote rdf:nodeID="N0e4699cc6a264b278739a0cea4bc8e0d"/>
    <skos:changeNote rdf:nodeID="N4c2a4c08b5fd41c680ab98cf329e2d50"/>
    <skos:changeNote rdf:nodeID="Nb51ee5a8bee24089b9451840fc0b731a"/>
    <skos:changeNote rdf:nodeID="N44dba1b7b8c6418a953423abab5f1dc1"/>
    <skos:scopeNote xml:lang="en">The relation implies that the two Persons met or at least
         corresponded with each other.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R051 ('knows'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
