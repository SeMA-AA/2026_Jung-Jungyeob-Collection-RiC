  <rdf:Description rdf:about="urn:sema:ontology:describesOrDescribed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadSubject"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasDescribedBy"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordResource"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Connects a Record Resource to a Thing that it describes or
         described.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">décrit ou a décrit</rdfs:label>
    <rdfs:label xml:lang="es">describe o describía</rdfs:label>
    <rdfs:label xml:lang="en">describes or described</rdfs:label>
    <skos:changeNote rdf:nodeID="N7947b3a490a94e6baad204d6ac68c0a1"/>
    <skos:changeNote rdf:nodeID="Nc4f6b42a51934b328e26bd9a236a452b"/>
    <skos:changeNote rdf:nodeID="Nb7a2ce15a4584099a417f76ce6025fe3"/>
    <skos:changeNote rdf:nodeID="Nc0c863f5e7d14aee8bc1e22d0041f2bf"/>
    <skos:scopeNote xml:lang="en">Can be used, among other situations, for specifying that some
         finding aid (a Record that has Documentary Form Type Finding Aid) describes some Record
         Set.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R021 ('describes or described'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:ActivityDocumentationRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N1b7702fcddfb4a00acf2c89d757645f0"/>
