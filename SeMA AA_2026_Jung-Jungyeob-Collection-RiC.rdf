    <rdfs:label xml:lang="en">Record Part</rdfs:label>
    <rdfs:label xml:lang="de">Recordteil</rdfs:label>
    <skos:changeNote rdf:nodeID="N3904399fd4924627819b7d5fb4def7ea"/>
