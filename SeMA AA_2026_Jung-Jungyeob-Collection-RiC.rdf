    <rdfs:subClassOf rdf:nodeID="N28a273da70ea46bf9411e3772bdc194a"/>
    <rdfs:comment xml:lang="en">Connects at least one Mandate and at least one Agent, when the
         first gives or gave the second one the authority or competencies to act. May also involve
         one to many Activities that the Mandate(s) assign(s) or assigned to the Agent(s). The
         Mandate(s) is the source of the Relation and the Agent(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="de">Mandat-Akteur</rdfs:label>
    <rdfs:label xml:lang="en">Mandate Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación normativa</rdfs:label>
    <rdfs:label xml:lang="fr">Relation impliquant un mandat</rdfs:label>
    <skos:changeNote rdf:nodeID="Ndb349507abd54f009a02ae54ff7b7fe9"/>
    <skos:changeNote rdf:nodeID="N274ba3a795684f019352c96d6330df7d"/>
    <skos:changeNote rdf:nodeID="N269aef1ec1904289bf60800875b4ec01"/>
