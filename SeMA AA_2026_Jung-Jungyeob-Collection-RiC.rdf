  <rdf:Description rdf:about="urn:sema:ontology:proxyInRecordSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:proxyIn"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Proxy"/>
    <rdfs:range rdf:resource="urn:sema:ontology:RecordSet"/>
    <rdfs:comment xml:lang="en">Connects a Proxy to a Record Set in which it stands for
         (represents) a Record or another Record Set.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">proxy dans l’ensemble d’objets informationnels</rdfs:label>
    <rdfs:label xml:lang="es">proxy en la agrupación documental</rdfs:label>
    <rdfs:label xml:lang="en">proxy in record set</rdfs:label>
    <skos:changeNote rdf:nodeID="N5001a6fe3a464b858cf74fd2a409c280"/>
    <skos:changeNote rdf:nodeID="Na4aa534796a542e8a972980578f4e80d"/>
