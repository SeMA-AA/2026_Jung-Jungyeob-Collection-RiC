  <rdf:Description rdf:about="urn:sema:ontology:hasSuccessor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAgentAssociatedWithAgent"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:precedesInTime"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isSuccessorOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Agent"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Agent"/>
    <owl:propertyChainAxiom rdf:nodeID="Naa0d38006a974ff5b3e4006acb325da9"/>
    <rdfs:comment xml:lang="en">Connects an Agent to another Agent that succeeds it
         chronologically.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a pour successeur</rdfs:label>
    <rdfs:label xml:lang="en">has successor</rdfs:label>
    <rdfs:label xml:lang="es">tiene como sucesor(a) a</rdfs:label>
    <skos:changeNote rdf:nodeID="N4693a8155b274eef9139832e0755cd9a"/>
    <skos:changeNote rdf:nodeID="Nf0550641235340b291bbcb432c648c71"/>
    <skos:changeNote rdf:nodeID="Nacef1f86efed4e64a4e929c8f332cf28"/>
    <skos:changeNote rdf:nodeID="N85b6fb94b3f046689de394a5ba18bf23"/>
    <skos:scopeNote xml:lang="en">There may be zero to many intermediate Agents, ignored or
         unknown, between the two connected Agents. Can be used when there is a transfer of function
         from the first Agent to the second Agent.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RIC-R016 ('has successor'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
