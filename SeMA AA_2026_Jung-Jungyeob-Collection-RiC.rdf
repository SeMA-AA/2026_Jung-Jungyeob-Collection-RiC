  <rdf:Description rdf:about="urn:sema:ontology:isOrWasAdjacentTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAssociatedWithPlace"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isPlaceAssociatedWith"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:comment xml:lang="en">Connects two Places that are or were geographically adjacent. This
         relation is symmetric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es o era un lugar contiguo a</rdfs:label>
    <rdfs:label xml:lang="fr">est ou a été adjacent à</rdfs:label>
    <rdfs:label xml:lang="en">is or was adjacent to</rdfs:label>
