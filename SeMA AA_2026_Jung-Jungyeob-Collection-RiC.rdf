  <rdf:Description rdf:about="urn:sema:vocabulary:documentaryFormTypes:IIIFManifest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="urn:sema:ontology:DocumentaryFormType"/>
    <skos:inScheme rdf:resource="urn:sema:vocabulary:documentaryFormTypes"/>
    <skos:broader rdf:resource="urn:sema:vocabulary:documentaryFormTypes:FindingAid"/>
    <rdfs:label xml:lang="en">IIIF manifest</rdfs:label>
    <rdfs:label xml:lang="fr">manifeste IIIF</rdfs:label>
    <skos:changeNote rdf:nodeID="N7d9de06d8b4147238135e53745df3995"/>
    <skos:definition xml:lang="en">Can be used to categorize records which describe collections of
         cultural heritage objects, or of a single cultural object, and whose instantiations are
         compliant to the IIIF Presentation API.</skos:definition>
  </rdf:Description>
