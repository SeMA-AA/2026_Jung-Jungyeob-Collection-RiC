  <rdf:Description rdf:about="urn:sema:ontology:isOrWasRegulatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAssociatedWithRule"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:regulatesOrRegulated"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Rule"/>
    <rdfs:comment xml:lang="en">Inverse of 'regulates or regulated' object
         property.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">está o estaba regulado por</rdfs:label>
    <rdfs:label xml:lang="fr">est ou a été régulé par</rdfs:label>
    <rdfs:label xml:lang="en">is or was regulated by</rdfs:label>
    <skos:changeNote rdf:nodeID="Nc6c3a4eda0ac4966baa83e9330cc3cd1"/>
