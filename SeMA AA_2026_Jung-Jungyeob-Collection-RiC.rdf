    <rdfs:label xml:lang="en">Record State</rdfs:label>
    <rdfs:label xml:lang="de">Recordstatus</rdfs:label>
    <skos:changeNote rdf:nodeID="N0be5eac44dc94e689cca77a223e8185b"/>
