         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:familyRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:FamilyRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:FamilyRelation"/>
    <rdfs:comment xml:lang="en">Connects a FamilyRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation familiale</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación familiar</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Family Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Nb1d738ebf76a4c72bb26393b36973893"/>
    <skos:changeNote rdf:nodeID="Nb7989df965ac4ff5a2eccec360075e4d"/>
    <skos:changeNote rdf:nodeID="N5d80c09a3de24cb69dcbfbbd26de4829"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the FamilyRelation class. It should be
         used only when you have to manage instances of the FamilyRelation class, to connect each
         instance to itself, in order to be able to infer, using OWL-RL and property paths, the two
         shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4d84b32a820a41ef82afc629d7f24919">
