    <isResponsibleForIssuing rdf:resource="urn:sema:resource:entity-046"/>
    <isResponsibleForIssuing rdf:resource="urn:sema:resource:entity-047"/>
    <isResponsibleForIssuing rdf:resource="urn:sema:resource:entity-048"/>
    <hasOrHadMember rdf:resource="urn:sema:resource:entity-017"/>
    <hasOrHadMember rdf:resource="urn:sema:resource:entity-021"/>
    <history xml:lang="ko">문화본부 산하 문화시설추진단 박물관과 소속 조직이었던 평창동미술문화복합공간조성추진반이 서울시립미술관으로 조직과 업무이관에 따라 부서명이 변경되었다. </history>
    <hasOrHadLanguage xml:lang="ko">한국어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">지방자치단체 사업소 행정기구</hasOrHadLegalStatus>
    <hasOrHadCorporateBodyType xml:lang="ko">공공</hasOrHadCorporateBodyType>
  </rdf:Description>
