    <skos:changeNote rdf:nodeID="N938469ae4d2249959ba86288b7260d6f"/>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R005 and RiC-R005i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
