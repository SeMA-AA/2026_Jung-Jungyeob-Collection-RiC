  <rdf:Description rdf:about="urn:sema:ontology:isRepresentationTypeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrWasTypeOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasRepresentationType"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RepresentationType"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:comment xml:lang="en">Connects a Representation Type to an Instantiation that it
         categorizes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es tipo de grabación de</rdfs:label>
    <rdfs:label xml:lang="fr">est le type de représentation de</rdfs:label>
    <rdfs:label xml:lang="en">is representation type of</rdfs:label>
    <skos:changeNote rdf:nodeID="N13435edb76c442499ba39c3b9d4dd53b"/>
    <skos:changeNote rdf:nodeID="N84a093a2af244e22bb5cdc3f6629c2af"/>
