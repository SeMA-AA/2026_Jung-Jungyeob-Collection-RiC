         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:migrationRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
