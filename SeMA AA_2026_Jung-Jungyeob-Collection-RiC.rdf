  <rdf:Description rdf:about="urn:sema:ontology:workRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:WorkRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:WorkRelation"/>
    <rdfs:comment xml:lang="en">Connects a WorkRelation to itself. It is a property that can stand
         for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation de travail</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación profesional</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Work Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="N96727eb42f424b8ba8a6c89db93751ec"/>
    <skos:changeNote rdf:nodeID="N1b4b816959604d519728ff726577cd96"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the WorkRelation class. It should be
         used only when you have to manage instances of the WorkRelation class, to connect each
         instance to itself, in order to be able to infer, using OWL-RL and property paths, the two
         shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N71f89e0e982a42e6b6b23b0b01e06146">
    <rdf:first rdf:resource="urn:sema:ontology:Record"/>
    <rdf:rest rdf:nodeID="N74340f04cee94a70a65cc082c43ffd47"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6189fa2530da41c5aede97820a58ff07">
    <dc:date>2023-11-08</dc:date>
    <rdf:value xml:lang="en">In order to get a system of rolified Relation classes: modified
               the property chain axiom so that it now involves the new managementRelation_role
               object property.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:isInstantiationAssociatedWithInstantiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRelatedTo"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <owl:propertyChainAxiom rdf:nodeID="Nd572389ae8ee433c92137aacfe0a434b"/>
    <rdfs:comment xml:lang="en">Connects two Instantiations. This relation is
         symmetric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">est associée à l’instanciation</rdfs:label>
    <rdfs:label xml:lang="en">is instantiation associated with instantiation</rdfs:label>
    <rdfs:label xml:lang="es">se asocia con la instanciación</rdfs:label>
    <skos:changeNote rdf:nodeID="Nef42af778e424e2f9ddb1a0a46a44153"/>
    <skos:changeNote rdf:nodeID="N6b76440db7dc4d188a547a0d1d483839"/>
    <skos:changeNote rdf:nodeID="Nae3b2f02e3fd464589253ef82cea0e4e"/>
    <skos:changeNote rdf:nodeID="Nc2dca4eade8d49c3ace161d2792f899d"/>
    <skos:scopeNote xml:lang="en">Use only if it is not possible to specify a narrower
         Instantiation to Instantiation relation, for example is functionally equivalent
         to.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R034 ('is instantiation associated with
         instantiation' relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
