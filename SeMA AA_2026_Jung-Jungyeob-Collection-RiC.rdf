  <rdf:Description rdf:about="urn:sema:ontology:studiesOrStudiedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrWasMemberOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasAttendedByStudent"/>
