               RiC-O compliant with RiC-CM v0.2.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadSomeMembersWithDocumentaryFormType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadSomeMembersWithType"/>
