  <rdf:Description rdf:about="urn:sema:ontology:derivationRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:instantiationToInstantiationRelation_role"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:temporalRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:DerivationRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:DerivationRelation"/>
    <rdfs:comment xml:lang="en">Connects a DerivationRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation de dérivation</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación de derivación</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Derivation Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="N2995cc51803f481887da2ed67a9f1023"/>
    <skos:changeNote rdf:nodeID="N43d1b73aae404bcfbfdae3bfc3a52233"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the DerivationRelation class. It should
         be used only when you have to manage instances of the DerivationRelation class, to connect
         each instance to itself, in order to be able to infer, using OWL-RL and property paths, the
         two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc4bfbfc844d446aaa560fef800aa9a3">
