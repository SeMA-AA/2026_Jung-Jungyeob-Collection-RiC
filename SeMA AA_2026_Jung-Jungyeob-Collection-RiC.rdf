    <rdfs:label xml:lang="de">Demographische Gruppe</rdfs:label>
    <rdfs:label xml:lang="fr">Groupe démographique</rdfs:label>
    <rdfs:label xml:lang="es">Grupo demográfico</rdfs:label>
    <skos:changeNote rdf:nodeID="Nc11e702e3c5c4dae9925dfa192ef77f9"/>
