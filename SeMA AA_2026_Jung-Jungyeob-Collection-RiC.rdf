  <rdf:Description rdf:about="urn:sema:ontology:GroupSubdivisionRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N9d21ce6029ed40ffb0b90a585499f4fa"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentHierarchicalRelation"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:WholePartRelation"/>
    <rdfs:subClassOf rdf:nodeID="N70af63d4a5134fd29e6581c9f3efac5a"/>
    <rdfs:subClassOf rdf:nodeID="N8fc0d306f3d64bb0b5501978a74bd122"/>
    <rdfs:comment xml:lang="en">Connects a Group and at least another Group, when the first one
         has or had the second one(s) among its subdivisions. The Relation is oriented from the
         Group to its subdivision(s): the parent Group is the source and the subdivision Group(s) is
         the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Group Subdivision Relation</rdfs:label>
    <rdfs:label xml:lang="de">Gruppe-Untergruppe</rdfs:label>
    <rdfs:label xml:lang="es">Relación de subdivisión entre grupos de agentes</rdfs:label>
    <rdfs:label xml:lang="fr">Relation de subdivision entre groupes d’agents</rdfs:label>
    <skos:changeNote rdf:nodeID="N5f8afc4c39a04430bce68eadb1cc1cfe"/>
    <skos:changeNote rdf:nodeID="N1348db6de0ea4b3c86d228268269f2e9"/>
