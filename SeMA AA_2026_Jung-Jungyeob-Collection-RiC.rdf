  <rdf:Description rdf:about="urn:sema:ontology:MandateRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nc4276fc9431442eeab81740e1f108b23"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:RuleRelation"/>
    <rdfs:subClassOf rdf:nodeID="N4d6742d7662e4dceae6b913d47ab5d3d"/>
