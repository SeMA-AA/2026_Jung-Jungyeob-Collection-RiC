  <rdf:Description rdf:about="urn:sema:ontology:InstantiationExtent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Extent"/>
    <rdfs:comment xml:lang="en">Countable characteristics of an Instantiation expressed as a
         quantity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">Extensión de la instanciación</rdfs:label>
    <rdfs:label xml:lang="en">Instantiation Extent</rdfs:label>
    <rdfs:label xml:lang="fr">Mesure d’une instanciation</rdfs:label>
    <rdfs:label xml:lang="de">Umfang der Instanz|Repräsentation</rdfs:label>
    <skos:changeNote rdf:nodeID="N08fccb9ae4cd48fe8e2bf75d1c0854e4"/>
    <skos:changeNote rdf:nodeID="N48f39d11759a4cea9f0b38430003e52a"/>
