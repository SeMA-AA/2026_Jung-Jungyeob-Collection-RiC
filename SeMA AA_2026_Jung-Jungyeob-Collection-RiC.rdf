    <skos:changeNote rdf:nodeID="Ncb64c561f7dd4521974a5136f99b10ad"/>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R018 and RiC-R018i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
