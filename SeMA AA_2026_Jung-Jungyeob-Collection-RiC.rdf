  <rdf:Description rdf:about="urn:sema:ontology:PlaceRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nc230326b0df74c50ade071d444dc5499"/>
