  <rdf:Description rdf:about="urn:sema:ontology:isDateOfOccurrenceOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAssociatedWithEvent"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isDateAssociatedWith"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:occurredAtDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Date"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:comment xml:lang="en">Connects a Date to an Event that occurred at this Date. An event
         or activity can be recurrent, which implies that one single event can be related to several
         dates.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es fecha de ocurrencia de</rdfs:label>
    <rdfs:label xml:lang="fr">est la date d'occurrence de</rdfs:label>
    <rdfs:label xml:lang="en">is date of occurrence of</rdfs:label>
