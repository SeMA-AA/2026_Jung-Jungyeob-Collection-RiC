  <rdf:Description rdf:about="urn:sema:ontology:migrationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:derivationDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment xml:lang="en">Date at which an Instantiation was or will be
         migrated.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">date de migration</rdfs:label>
    <rdfs:label xml:lang="es">fecha de migración</rdfs:label>
    <rdfs:label xml:lang="en">migration date</rdfs:label>
    <skos:changeNote rdf:nodeID="Nb14823b233fa4f77a46af890cca38572"/>
    <skos:changeNote rdf:nodeID="Ndbe36da27bca4d6697457152c68d1b09"/>
    <skos:scopeNote xml:lang="en">Provided for usability reasons. May be deprecated and removed
         later on. Use only if you don't use Date classes for handling dates.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Datatype property specialized implementation of
         RiC-E18 (Date entity)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:precedesOrPreceded">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRelatedTo"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:followsOrFollowed"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <owl:propertyChainAxiom rdf:nodeID="N618da6675e0748ae8f6f7059b41012f3"/>
    <rdfs:comment xml:lang="en">Connects a Thing to a Thing that follows or followed it in some
         sequence.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">precede o precedía secuencialmente a</rdfs:label>
    <rdfs:label xml:lang="fr">précède ou a précédé</rdfs:label>
    <rdfs:label xml:lang="en">precedes or preceded</rdfs:label>
    <skos:changeNote rdf:nodeID="Ne07b682208a34ab283200eea9c6797c8"/>
    <skos:changeNote rdf:nodeID="N8561bbac378e4193a0d22e8e660a6e41"/>
    <skos:changeNote rdf:nodeID="N2a4a748c3db247f486fb23bf2ee6d1ae"/>
    <skos:changeNote rdf:nodeID="Nbdccd04b1bd24755acb9d3d6221ceb4f"/>
    <skos:scopeNote xml:lang="en">The relation does not specify by itself what criteria are used
         for ordering the sequence. There may actually be zero to many intermediate Entities,
         ignored or unkown, in the sequence between the two connected Things. Can be used, for
         example, for specifying that some Record 'precedes' (has next) some Record within a Record
         Set.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R008 ('precedes or preceded'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
