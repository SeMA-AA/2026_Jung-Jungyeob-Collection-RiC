    <skos:changeNote rdf:nodeID="N35f387347ca64851b400340bbe08d48e"/>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R074 and RiC-R074i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
