    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAgentAssociatedWithPlace"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isDeathPlaceOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Person"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Place"/>
