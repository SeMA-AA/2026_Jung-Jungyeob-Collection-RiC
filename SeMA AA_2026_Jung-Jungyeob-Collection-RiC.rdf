  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadConstituent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadPart"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRecordResourceAssociatedWithRecordResource"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasConstituentOf"/>
    <rdfs:domain rdf:nodeID="Nc4ea8a580c3e44c486444cfea3b17be3"/>
    <rdfs:range rdf:nodeID="Nabce997960ae46b095ff43b711e7733d"/>
    <rdfs:comment xml:lang="en">Connects a Record or Record Part to a Record or Record part that
         is or was a constituent of that Record or Record Part.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
