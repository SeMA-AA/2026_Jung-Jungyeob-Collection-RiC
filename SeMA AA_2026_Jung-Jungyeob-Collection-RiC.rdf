  <rdf:Description rdf:about="urn:sema:ontology:Family">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Group"/>
    <rdfs:comment xml:lang="en">Two or more persons related by birth, or through marriage,
         adoption, civil union, or other social conventions that bind them together as a socially
         recognized familial group.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">Familia</rdfs:label>
    <rdfs:label xml:lang="de">Familie</rdfs:label>
    <rdfs:label xml:lang="fr">Famille</rdfs:label>
    <rdfs:label xml:lang="en">Family</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd9fbc6a48b55484696efa5f1617759ff"/>
    <skos:changeNote rdf:nodeID="N01d590ced7ad4d65b6906aa6a5b967b6"/>
    <skos:changeNote rdf:nodeID="Ne24d6fbafc97429bb4c356edb41c3ec0"/>
    <skos:changeNote rdf:nodeID="N589672f0ad1941f59dcccf30236267f2"/>
    <skos:scopeNote xml:lang="en">Family is a kind of Group. “Family” is used here as a general
         term that encompasses a wide variety of familial groups. Other types of familial groups
         include Dynasty, Clan, House, Tribe and others. Though family may be a recognized legal
         group in specific contexts, the term may also be used for groups that are socially
         recognized as families. A family may be a group of persons related either by consanguinity
         or affinity or cohabitation or other social conventions. In some context, a Family may be
         legally recognized as Corporate Body. For example, certain North American peoples (tribes)
         retain self-government rights and have jurisdiction over defined tribal
         lands.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-E10 (Family
         entity)</RiCCMCorrespondingComponent>
  </rdf:Description>
