  <rdf:Description rdf:about="urn:sema:vocabulary:recordSetTypes:Series">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="urn:sema:ontology:RecordSetType"/>
    <skos:inScheme rdf:resource="urn:sema:vocabulary:recordSetTypes"/>
    <skos:topConceptOf rdf:resource="urn:sema:vocabulary:recordSetTypes"/>
    <rdfs:label xml:lang="es">serie</rdfs:label>
    <rdfs:label xml:lang="fr">série organique</rdfs:label>
    <rdfs:label xml:lang="en">series</rdfs:label>
    <skos:changeNote rdf:nodeID="Nb5a0951e19954c9f9f969ba9df29046d"/>
    <skos:changeNote rdf:nodeID="N50760bceb82646bbaebd7d52a04a97ef"/>
    <skos:definition xml:lang="en">Documents arranged in accordance with a filing system or
         maintained as a unit because they result from the same accumulation or filing process, or
         the same activity; have a particular form; or because of some other relationship arising
         out of their creation, receipt, or use. A series is also known as a records series. (From
         ICA ISAD(G))</skos:definition>
  </rdf:Description>
