  <rdf:Description rdf:about="urn:sema:ontology:isDirectComponentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isComponentOfTransitive"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isDirectPartOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasDirectComponent"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:comment xml:lang="en">Connects an Instantiation to another Instantiation of which it is
         a direct component.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es componente directo de</rdfs:label>
    <rdfs:label xml:lang="fr">est le composant direct de</rdfs:label>
    <rdfs:label xml:lang="en">is direct component of</rdfs:label>
    <skos:changeNote rdf:nodeID="N3667069b76d64bfe9dca3b418b9f754a"/>
    <skos:changeNote rdf:nodeID="Na03bc305177e4b1796c6a7a5b452a4c7"/>
    <skos:changeNote rdf:nodeID="N691c1e41ef0b4dec98208577590bcf5b"/>
  </rdf:Description>
