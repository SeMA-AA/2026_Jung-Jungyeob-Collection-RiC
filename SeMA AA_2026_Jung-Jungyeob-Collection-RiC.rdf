    <owl:inverseOf rdf:resource="urn:sema:ontology:isDirectSubeventOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:comment xml:lang="en">Connects an ongoing Event to one of a series of Events that
         directly constitute that broader, ongoing Event.</rdfs:comment>
