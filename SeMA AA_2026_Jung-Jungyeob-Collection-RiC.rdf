  <rdf:Description rdf:about="urn:sema:ontology:Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Agent"/>
    <owl:disjointWith rdf:resource="urn:sema:ontology:Mechanism"/>
    <owl:disjointWith rdf:resource="urn:sema:ontology:Person"/>
    <owl:disjointWith rdf:resource="urn:sema:ontology:Position"/>
    <rdfs:comment xml:lang="en">Two or more Agents that act together as an Agent.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Group</rdfs:label>
    <rdfs:label xml:lang="fr">Groupe d’agents</rdfs:label>
    <rdfs:label xml:lang="es">Grupo de agentes</rdfs:label>
    <rdfs:label xml:lang="de">Gruppe</rdfs:label>
    <skos:changeNote rdf:nodeID="N3c85cd2c8b47460d8425f40255d4c155"/>
    <skos:changeNote rdf:nodeID="N1868150f612e4d61afdd9b6a1efbf136"/>
    <skos:changeNote rdf:nodeID="N1e150a45377342bcbb395180b832f8ce"/>
    <skos:changeNote rdf:nodeID="Nec101710fca14ca2b9b42f0c95e2227e"/>
    <skos:scopeNote xml:lang="en">Group is a kind of Agent. A Group has a socially recognized
         identity. Each member of the Group plays a particular role or roles (that is has a
         particular Position) in the coordinated activity of the Group. Corporate bodies and
         families are kinds of groups, though other kinds of groups are possible. For example, the
         “electorate” -- all of the voters in a given election. Complex, large groups may be
         subdivided into other groups.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-E09 (Group
         Entity)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd5e96375bed449eaa324d7a35c549172">
    <dc:date>2020-10-23</dc:date>
    <rdf:value xml:lang="en">Scope note: made separate paragraphs and some
               changes.</rdf:value>
