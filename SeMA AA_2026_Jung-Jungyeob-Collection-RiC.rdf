  <rdf:Description rdf:about="urn:sema:ontology:groupSubdivisionRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentHierarchicalRelation_role"/>
