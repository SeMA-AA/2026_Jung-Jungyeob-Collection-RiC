  <rdf:Description rdf:about="urn:sema:ontology:membershipRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:agentToAgentRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:MembershipRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:MembershipRelation"/>
    <rdfs:comment xml:lang="en">Connects a MembershipRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation d’appartenance</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación de membresía</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Membership Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="Na592d4a49838486088c06d80cc3c2fb2"/>
    <skos:changeNote rdf:nodeID="Na4a65d25f0e64d36b04a644e4f762992"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the MembershipRelation class. It should
         be used only when you have to manage instances of the MembershipRelation class, to connect
         each instance to itself, in order to be able to infer, using OWL-RL and property paths, the
         two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
