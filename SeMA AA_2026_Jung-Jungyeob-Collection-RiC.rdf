  <rdf:Description rdf:about="urn:sema:ontology:mostMembersWithCreationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:someMembersWithCreationDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordSet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment xml:lang="en">Date at which most of the present or past members of a Record Set
         were or will be created.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">des membres dont la plupart ont pour date de création</rdfs:label>
    <rdfs:label xml:lang="es">la mayoría de sus miembros como fecha de creación</rdfs:label>
    <rdfs:label xml:lang="en">most members with creation date</rdfs:label>
    <skos:changeNote rdf:nodeID="N0230ac9418e84e8bb30564b0bf01ef8f"/>
    <skos:changeNote rdf:nodeID="N75483d798aca45559de0ff6abfc74c10"/>
    <skos:scopeNote xml:lang="en">Datatype property analogue of
         'hasOrHadMostMembersWithCreationDate', which is provided for usability reasons. May be
         deprecated and removed later on. Use only if you don’t use Date classes for handling
         dates.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R083i ('has or had most members with creation
         date' relation).</RiCCMCorrespondingComponent>
  </rdf:Description>
