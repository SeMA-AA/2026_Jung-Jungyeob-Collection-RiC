  <rdf:Description rdf:about="urn:sema:ontology:isDateTypeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrWasTypeOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasDateType"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:DateType"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Date"/>
    <rdfs:comment xml:lang="en">Connects a Date Type to a Date that it categorizes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es tipo de fecha de</rdfs:label>
