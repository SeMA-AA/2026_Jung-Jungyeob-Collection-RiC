  <rdf:Description rdf:about="urn:sema:ontology:relationHasContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:relationConnects"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:thingIsContextOfRelation"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Relation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Connects an n-ary Relation to a Thing that is a secondary,
         contextual entity during the existence of the Relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">relación tiene como contexto</rdfs:label>
    <rdfs:label xml:lang="fr">relation a pour contexte</rdfs:label>
    <rdfs:label xml:lang="en">relation has context</rdfs:label>
