  <rdf:Description rdf:about="urn:sema:ontology:roleIsContextOfCreationRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:thingIsContextOfRelation"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:creationWithRole"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RoleType"/>
    <rdfs:range rdf:resource="urn:sema:ontology:CreationRelation"/>
    <rdfs:comment xml:lang="en">Connects a Role Type to a Creation Relation (this Role Type being
         the specific role played by the creating Person in the context of this
         Relation).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">rôle est le contexte de la relation de création</rdfs:label>
    <rdfs:label xml:lang="en">role is context of creation relation</rdfs:label>
    <rdfs:label xml:lang="es">rol es contexto de relación de creación</rdfs:label>
    <skos:changeNote rdf:nodeID="N1e39332b3a91470485e46348c7df9be9"/>
    <skos:changeNote rdf:nodeID="N8a05301bba42472dbb6e23510f8e4156"/>
