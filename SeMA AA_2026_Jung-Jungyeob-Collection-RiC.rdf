  <rdf:Description rdf:about="urn:sema:ontology:containsTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:containsOrContained"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasPartTransitive"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isContainedByTransitive"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Place"/>
    <rdfs:comment xml:lang="en">Connects a Place to a Place that it contains, directly or
         indirectly. This is a transitive relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">contains transitive</rdfs:label>
    <rdfs:label xml:lang="es">contiene transitivo</rdfs:label>
    <rdfs:label xml:lang="fr">contient transitif</rdfs:label>
    <skos:changeNote rdf:nodeID="N8ebf977fa2d74f5f80e755032d4383fe"/>
    <skos:changeNote rdf:nodeID="N87c01cef6dfb4e80a5586122870fa0d8"/>
    <skos:changeNote rdf:nodeID="Nbc54abfcc86f4b0db5129d8842c137fc"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:EventRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nff120a35e37146f8a50f9f4b76f73e5f"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Relation"/>
    <rdfs:subClassOf rdf:nodeID="N527f01f8cb57486f8ef632b58d159a8d"/>
    <rdfs:subClassOf rdf:nodeID="N00d18ad7a5554c8286c9e8c9fccccef3"/>
    <rdfs:comment xml:lang="en">Connects at least one Event to at least one Thing, when the first
         is associated with the existence and lifecycle of the second one. The Event(s) is the
         source of the Relation, and the Thing(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="de">Ereignis-Ding</rdfs:label>
    <rdfs:label xml:lang="en">Event Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación con un evento</rdfs:label>
    <rdfs:label xml:lang="fr">Relation impliquant un événement</rdfs:label>
    <skos:changeNote rdf:nodeID="N01a761868da645bf813c0b2cb206b3ad"/>
    <skos:changeNote rdf:nodeID="Nc7e1cd3e3ed14b1e807fff5a3e3683b6"/>
    <skos:changeNote rdf:nodeID="N0b4963d0ac4e41179754938ab55ec4e9"/>
    <skos:changeNote rdf:nodeID="Nfc4bfbfc844d446aaa560fef800aa9a3"/>
    <skos:changeNote rdf:nodeID="Ndd50875e0d7a4ea3918b4240897f04c8"/>
    <skos:changeNote rdf:nodeID="Ne61211a18b51444b952c0fd74f46cbec"/>
    <skos:scopeNote xml:lang="en">Use to connect an event and an entity only if it is not possible
         to specify a narrower event relation, for example a PerformanceRelation.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R057 and RiC-R057i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:hasDeathDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
