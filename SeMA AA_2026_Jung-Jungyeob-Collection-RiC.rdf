    <regulatesOrRegulated rdf:resource="urn:sema:resource:entity-036"/>
    <issuedBy rdf:resource="urn:sema:resource:entity-028"/>
    <generalDescription xml:lang="ko">이 조례는 서울특별시가 건립추진 중이거나 운영하는 박물관의 박물관자료 수집 및 관리 등에 관한 필요한 사항을 규정함을 목적으로 한다.</generalDescription>
    <history xml:lang="ko">2016년 7월 14일에 제정 및 시행되었다.</history>
    <hasOrHadRuleType xml:lang="ko">자치법규(조례)</hasOrHadRuleType>
