  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRelatedTo"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasPartOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <owl:propertyChainAxiom rdf:nodeID="N1f516347a5bb4b5abb8e371e4916551c"/>
    <rdfs:comment xml:lang="en">Connects a Thing to a constitutive or component part of that
         Thing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour partie</rdfs:label>
    <rdfs:label xml:lang="en">has or had part</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como parte</rdfs:label>
    <skos:changeNote rdf:nodeID="Nc472b66f29af4d1b80a56d14334faa8a"/>
    <skos:changeNote rdf:nodeID="N95edb5b2cf0d4bae82ebad0404914195"/>
    <skos:changeNote rdf:nodeID="Na8176291f56642138bdce0d65796a20f"/>
    <skos:changeNote rdf:nodeID="N999dc056e6554713b92677e09456ee9f"/>
    <skos:changeNote rdf:nodeID="N1ded1597307340dd98ed531f824152d8"/>
    <skos:scopeNote xml:lang="en">Use to connect a Thing to another Thing that is or was a part of
         the whole Thing only if it is not possible to use a narrower, more specific whole/part
         relation, for example has or had constituent. The end of existence of a whole/part relation
         may affect the integrity or nature of the domain entity.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R002 ('has or had part'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
