         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:resource:entity-050">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:ArtWork"/>
    <rdfs:label xml:lang="ko">〈밥상〉</rdfs:label>
    <identifier>sample-entity-050</identifier>
    <identifier>2013-225</identifier>
    <name xml:lang="ko">〈밥상〉</name>
    <type xml:lang="ko">작품</type>
    <hasOrHadInstantiation rdf:resource="urn:sema:resource:entity-014"/>
    <isContextualizedBy rdf:resource="urn:sema:resource:entity-002"/>
    <hasOrHadMainSubject rdf:resource="urn:sema:resource:entity-001"/>
