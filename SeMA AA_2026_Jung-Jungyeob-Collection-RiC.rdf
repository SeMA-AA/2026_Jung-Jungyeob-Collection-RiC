  <rdf:Description rdf:about="urn:sema:ontology:isDirectSubdivisionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isDirectPartOf"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isDirectSubordinateTo"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isSubdivisionOfTransitive"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasDirectSubdivision"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Group"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Group"/>
    <rdfs:comment xml:lang="en">Connects a Group to the Group it is a direct subdivision
         of.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es subdivisión directa de</rdfs:label>
