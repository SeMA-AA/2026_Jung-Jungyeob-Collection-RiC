  <rdf:Description rdf:about="urn:sema:ontology:isFromUseDateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isBeginningDateOf"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:wasUsedFromDate"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Date"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Appellation"/>
    <rdfs:comment xml:lang="en">Connects a Date to an Appellation, when it is the date at which
         the Appellation was first used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es fecha desde la que se usa de</rdfs:label>
    <rdfs:label xml:lang="fr">est la date à partir de laquelle est utilisé</rdfs:label>
    <rdfs:label xml:lang="en">is from use date of</rdfs:label>
    <skos:changeNote rdf:nodeID="N823031fa52a943bfac67d27f38d0852a"/>
    <skos:changeNote rdf:nodeID="N84b4d4886e854e81916f49b02e3e89f8"/>
