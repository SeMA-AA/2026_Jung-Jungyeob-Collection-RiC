  <rdf:Description rdf:about="urn:sema:ontology:KnowingOfRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N0d8ab6566d9b439395e139cdfa250dd2"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentToAgentRelation"/>
