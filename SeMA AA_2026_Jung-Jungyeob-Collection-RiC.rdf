  <rdf:Description rdf:about="urn:sema:resource:entity-002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:RecordSet"/>
    <rdfs:label xml:lang="ko">정정엽 컬렉션</rdfs:label>
    <identifier>sample-entity-002</identifier>
    <identifier>C11</identifier>
    <name xml:lang="ko">정정엽 컬렉션</name>
    <type xml:lang="ko">컬렉션</type>
    <isTargetOf rdf:resource="urn:sema:resource:entity-034"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-035"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-036"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-037"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-039"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-040"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-041"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-042"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-043"/>
    <isTargetOf rdf:resource="urn:sema:resource:entity-044"/>
    <hasCreator rdf:resource="urn:sema:resource:entity-015"/>
    <hasOrHadInstantiation rdf:resource="urn:sema:resource:entity-008"/>
    <hasOrHadLocation rdf:resource="urn:sema:resource:entity-049"/>
    <hasOrHadManager rdf:resource="urn:sema:resource:entity-017"/>
    <hasOrHadMainSubject rdf:resource="urn:sema:resource:entity-001"/>
    <providesContextFor rdf:resource="urn:sema:resource:entity-050"/>
    <hasOrHadPart rdf:resource="urn:sema:resource:entity-003"/>
    <generalDescription xml:lang="ko">정정엽 컬렉션은 2019년 정정엽으로부터 수집한 자료 500여 건으로 구성되어 있다. 정정엽의 활동은 컬렉션의 구성과 계층 분류에도 그대로 적용할 수 있다. 579건의 수집자료는 ‘참여 전시 자료’, ‘활동 자료’, 그 밖의 ‘개인 기록', 세 시리즈로 구분하고, 세 시리즈는 각각 2, 3개의 하위 시리즈로 구분할 수 있다. ‘참여 전시 자료’의 경우 개인전과 단체전의 하위 시리즈로 분류하며, ‘활동 자료’의 경우 개인 활동과 단체 활동, 삽화의 하위 시리즈로 분류하여 살펴볼 수 있다. ‘개인 기록’에는 전시나 단체 활동으로 구분되지 않는 작가의 여행노트나 스크랩 등을 분류했다. 정정엽 컬렉션은 자료를 각각의 분류기준에 따라 계층화 및 조직화한 '계층분류'와 자료의 물리적 형태에 따른 '형태분류'가 적용된다.</generalDescription>
    <authenticityNote xml:lang="ko">아트아카이브 관리시스템 내 등록 및 관리되고 있다.</authenticityNote>
    <classification xml:lang="ko">하위계층: 정정엽 컬렉션 &gt; 참여 전시 자료
정정엽 컬렉션 &gt; 활동 자료
정정엽 컬렉션 &gt; 개인 기록</classification>
    <conditionsOfAccess xml:lang="ko">부분공개</conditionsOfAccess>
    <conditionsOfUse xml:lang="ko">「서울시립 미술아카이브 공개 및 열람 규정」에 따라 열람이 가능하다.</conditionsOfUse>
    <isContentTypeOf xml:lang="ko">도서간행물, 문서, 사진, 음성영상, 박물, 홍보인쇄물</isContentTypeOf>
    <integrityNote xml:lang="ko">아트아카이브 관리시스템 내 감사증적을 통해 유지되고 있다.</integrityNote>
    <hasOrHadLanguage xml:lang="ko">노르웨이어, 독일어, 라오어, 러시아어, 스페인어, 영어, 일본어, 티벳어, 프랑스어, 한국어, 한자, 힌디어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">예술자료</hasOrHadLegalStatus>
    <recordResourceExtent xml:lang="ko">총 수량 579건(도서간행물 86건, 문서 209건, 사진 93건, 음성영상 3건, 박물 79건, 홍보인쇄물 109건)</recordResourceExtent>
    <scopeAndContent xml:lang="ko">정정엽 컬렉션은 I.참여전시자료, II.활동자료, 그밖의 III.개인기록, 세 시리즈로 구분한다. I.참여전시자료의 경우 다시 개인전과 단체전의 하위시리즈로 분류하며, II.활동자료의 경우 개인활동과 단체활동, 삽화의 하위시리즈로 분류하여 살펴볼 수 있다. 두렁의 민중미술과 여미연의 여성미술은 정정엽 컬렉션을 구성하는 두 축인데, 작업 방식 면에서 개인과 단체를 오가며 혹은 병행하며 활동한 것이 정정엽 컬렉션의 계층분류 기준이 된다.</scopeAndContent>
    <hasRecordState xml:lang="ko">원본, 사본</hasRecordState>
    <structure xml:lang="ko">&lt;정정엽&gt;컬렉션 비전자 자료는 아카이브의 물리적 형태에 따라 정리되어 있으며, 3-P-0001, 3-R-0012부터 3-R-0019, 4-M-0006, 4-M-0008 총 11개 보존상자와 박물류 서고에 배치되어 있다. 전자 자료는 해당 분류체계와 동일하게 정리되어 있다.</structure>
    <accruals xml:lang="ko">수집완료</accruals>
    <hasDocumentaryFormType xml:lang="ko">일반문서, 증서, 선언문, 서신, 노트및메모, 스크랩</hasDocumentaryFormType>
    <hasRecordSetType xml:lang="ko">컬렉션(C)</hasRecordSetType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9b35e6023dff4319a68048c1c4cb1f1a">
    <dc:date>2023-11-08</dc:date>
    <rdf:value xml:lang="en">In order to get a system of rolified Relation classes: modified
               the property chain axiom so that it now involves the new ownershipRelation_role
               object property.</rdf:value>
  </rdf:Description>
