  <rdf:Description rdf:about="urn:sema:ontology:authorityRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:relation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:AuthorityRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:AuthorityRelation"/>
    <rdfs:comment xml:lang="en">Connects an AuthorityRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation d’autorité</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación de control por parte de
         agentes</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Authority Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="N85ec718f8f2344da9307c5f7f1ea7b3c"/>
    <skos:changeNote rdf:nodeID="Nc7fc79bb49ff43fcae52e773b1c7e2f5"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the AuthorityRelation class. It should
         be used only when you have to manage instances of the AuthorityRelation class, to connect
         each instance to itself, in order to be able to infer, using OWL-RL and property paths, the
         two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
