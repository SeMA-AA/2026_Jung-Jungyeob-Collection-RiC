  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadSubevent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadPart"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isAssociatedWithEvent"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isEventAssociatedWith"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasSubeventOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:comment xml:lang="en">Connects an Event to one of a series of Events that constitute the
         original, broader, past or ongoing Event.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">est ou a été constitué de l’événement</rdfs:label>
    <rdfs:label xml:lang="en">has or had subevent</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como parte de evento</rdfs:label>
    <skos:changeNote rdf:nodeID="N1aa5dde4bc344558803286c78ca4762a"/>
    <skos:changeNote rdf:nodeID="N7cb7f7f1aeaf4e5e861a8659e03f4efe"/>
    <skos:changeNote rdf:nodeID="N913432b6ad4b43b7b37e15657c7dc22c"/>
    <skos:scopeNote xml:lang="en">Since an Activity is a kind of Event, this Relation can also be
         used for Activity.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R006 ('has or had subevent'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
