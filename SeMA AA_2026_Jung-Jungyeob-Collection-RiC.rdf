    <skos:changeNote rdf:nodeID="N0cad41348e0544228be7e40fbd711799"/>
    <skos:scopeNote xml:lang="en">This is the most general organic provenance relation. Use it to
         connect a Record Resource or Instantiation with an Agent only if it is not possible to use
         a narrower, more specific relation, for example has creator.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R026 ('has provenance'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
