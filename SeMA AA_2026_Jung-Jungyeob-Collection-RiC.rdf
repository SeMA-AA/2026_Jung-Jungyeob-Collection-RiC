  <rdf:Description rdf:about="urn:sema:ontology:DescendanceRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N20d6c44ab1124246ab036ab3d2df0728"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentTemporalRelation"/>
