  <rdf:Description rdf:nodeID="N402c37a2bf0440bf80189b906f6f97fe">
    <dc:date>2020-12-28</dc:date>
    <rdf:value xml:lang="en">Object property added for handling the case where a Record Set
               is described as having all or some members that belong to some category (see RiC-CM
               0.2 attributes section, #4.4 on Record Set, Record and Record Part
               attributes).</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:KnowingRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N506cb620f0b140f3adbc9013079b4816"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentToAgentRelation"/>
    <rdfs:subClassOf rdf:nodeID="Nc87c93fa5b014e19836201c4e70100dd"/>
    <rdfs:comment xml:lang="en">Connects at least two Persons who directly know each other during
         their existence. This Relation is not oriented.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Knowing Relation</rdfs:label>
    <rdfs:label xml:lang="de">Person-Bekanntschaft-Person</rdfs:label>
    <rdfs:label xml:lang="es">Relación de conocimiento directo entre personas</rdfs:label>
    <rdfs:label xml:lang="fr">Relation de connaissance entre personnes</rdfs:label>
    <skos:changeNote rdf:nodeID="Nd115b0749d7a459194ee9d373fb7381e"/>
    <skos:changeNote rdf:nodeID="Nb296d3d58264448eb83f0364485c1240"/>
    <skos:changeNote rdf:nodeID="N811c9c962bf74b379986362beabb9f23"/>
