    <skos:changeNote rdf:nodeID="N7b6d8ace7b424dd3a4e527449cdcb76d"/>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R028 and RiC-R028i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
