    <rdfs:subClassOf rdf:nodeID="N89213ec9e095458e9ddbd74d1de0da66"/>
    <rdfs:subClassOf rdf:nodeID="N6900ece9e77042028dcadf4d3f52722b"/>
    <rdfs:comment xml:lang="en">Connects a Place and at least one Thing when the first is
         associated with the existence and lifecycle of the second one. The Place is the source of
         the Relation and the Thing(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="de">Geografikum-Ding</rdfs:label>
    <rdfs:label xml:lang="en">Place Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación con lugar</rdfs:label>
    <rdfs:label xml:lang="fr">Relation impliquant un lieu</rdfs:label>
