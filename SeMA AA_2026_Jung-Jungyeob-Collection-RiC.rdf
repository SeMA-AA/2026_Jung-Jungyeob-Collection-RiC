  <rdf:Description rdf:about="urn:sema:ontology:hasContentWhichMainlyRepresents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasContentWhichRepresents"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadMainSubject"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isMainThingRepresentedByContentOf"/>
    <rdfs:domain rdf:nodeID="Neb10636a55354e9f8f4fe43cbcbeb365"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Connects a Record or a Record Part to a Thing that its content
         mainly represents.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a un contenu qui représente principalement</rdfs:label>
    <rdfs:label xml:lang="en">has content which mainly represents</rdfs:label>
    <rdfs:label xml:lang="es">tiene contenido que representa principalmente</rdfs:label>
    <skos:changeNote rdf:nodeID="Nf820fdd193ac41239fddb72d5adf6ac3"/>
    <skos:scopeNote xml:lang="en">A common use case would be to connect a photograph of a person
         (a portrait) and the person represented.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:dimensions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">dimensions</rdfs:label>
