    <rdfs:range rdf:nodeID="N3191eda08e984c269400097aa2f64f7d"/>
    <owl:propertyChainAxiom rdf:nodeID="N528f05fb02c24657a258a3297c5fa463"/>
    <rdfs:comment xml:lang="en">Inverse of 'is constituent of proxy' object
         property.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">proxy a pour constituant</rdfs:label>
