    <rdfs:label xml:lang="fr">résulte de la séparation de</rdfs:label>
    <rdfs:label xml:lang="en">resulted from the split of</rdfs:label>
    <skos:changeNote rdf:nodeID="N14d1450316a34eaaa1159b3b7492bf5d"/>
