    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:relationConnects"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:thingIsTargetOfRelation"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Relation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Connects an n-ary Relation to a Thing that is its
         target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">relación tiene como objetivo</rdfs:label>
    <rdfs:label xml:lang="fr">relation a pour cible</rdfs:label>
    <rdfs:label xml:lang="en">relation has target</rdfs:label>
