  <rdf:Description rdf:about="urn:sema:ontology:AgentTemporalRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nba83e8e3f42c48ec9a3a43e8bf72e641"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:AgentToAgentRelation"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:TemporalRelation"/>
    <rdfs:subClassOf rdf:nodeID="N0b059e2d24634a1db53966caff21a01c"/>
    <rdfs:subClassOf rdf:nodeID="N00f6f042b8c34ba9b3eaf0d7a1be1d04"/>
    <rdfs:comment xml:lang="en">Connects at least one Agent to at least another Agent that
         succeeds it chronologically for, for instance, fullfilling some functions or performing
         some activities. The Relation is oriented chronologically, from the predecessor to the
         successor: the predecessor Agent(s) is the source of the Relation, and the successor
         Agent(s) is the target.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Agent Temporal Relation</rdfs:label>
    <rdfs:label xml:lang="de">Akteur-Nachfolge</rdfs:label>
    <rdfs:label xml:lang="es">Relación temporal entre agentes</rdfs:label>
    <rdfs:label xml:lang="fr">Relation temporelle entre agents</rdfs:label>
    <skos:changeNote rdf:nodeID="Ndbfdff152065421db5e33bc4a8d3dadd"/>
    <skos:changeNote rdf:nodeID="N5e542de3465f49a885cd4569f1f2c50a"/>
    <skos:changeNote rdf:nodeID="Nc7e4c96166ad45f28b72870008fb75c6"/>
    <skos:changeNote rdf:nodeID="Nfd66a0906c6540b0bedea59cf3519a53"/>
    <skos:changeNote rdf:nodeID="Nfbe1cee6893e4591948c2c71710a6feb"/>
    <skos:changeNote rdf:nodeID="Nf8b0e8024ace424c808bf146b5276d24"/>
    <skos:changeNote rdf:nodeID="Nbf0da8d2fa7849aea7d09ea0a93975a4"/>
    <skos:scopeNote xml:lang="en">There may be zero to many intermediate agents, ignored or
         unknown, between the two connected agents. Can be used when there is a transfer of function
         from the first agent to the second agent.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R016 and RiC-016i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
