  <rdf:Description rdf:about="urn:sema:resource:entity-027">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:CorporateBody"/>
    <rdfs:label xml:lang="ko">서울시립미술관</rdfs:label>
    <identifier>sample-entity-027</identifier>
    <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6110514</identifier>
    <name xml:lang="ko">서울시립미술관</name>
    <type xml:lang="ko">미술관</type>
    <generalDescription xml:lang="ko">「서울특별시립미술관 관리 및 운영 조례」 및 동시행규칙에 의거하여 운영된다.</generalDescription>
    <history xml:lang="ko">1988년 개관한 서울시립미술관은 현재 서소문본관과 북서울미술관, 남서울미술관, 서울시립 미술아카이브, 난지미술창작스튜디오, SeMA 창고, SeMA 벙커, 백남준기념관의 8개 기관으로 구성, 운영되고 있다.</history>
    <hasOrHadLanguage xml:lang="ko">한국어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">지방자치단체 사업소</hasOrHadLegalStatus>
    <hasOrHadCorporateBodyType xml:lang="ko">공공</hasOrHadCorporateBodyType>
  </rdf:Description>
