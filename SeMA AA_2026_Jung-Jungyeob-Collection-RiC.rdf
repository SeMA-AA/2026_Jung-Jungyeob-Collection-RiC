  <rdf:Description rdf:about="urn:sema:ontology:isComponentOfTransitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isOrWasComponentOf"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isPartOfTransitive"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:hasComponentTransitive"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:comment xml:lang="en">Connects an Instantiation to another Instantiation of which it is,
         directly or indirectly, a component. This is a transitive relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es componente de transitivo</rdfs:label>
    <rdfs:label xml:lang="fr">est un composant de transitif</rdfs:label>
    <rdfs:label xml:lang="en">is component of transitive</rdfs:label>
    <skos:changeNote rdf:nodeID="N5c539203873344a69156439470c3cafe"/>
    <skos:changeNote rdf:nodeID="Neb5329d4483448b7a630e3cda73cee73"/>
