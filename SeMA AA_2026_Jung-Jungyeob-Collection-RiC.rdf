    <identifier>sample-entity-046</identifier>
    <identifier>AA_R1</identifier>
    <name xml:lang="ko">등록메타데이터 작성 매뉴얼</name>
    <type xml:lang="ko">시립미술아카이브 매뉴얼</type>
    <regulatesOrRegulated rdf:resource="urn:sema:resource:entity-039"/>
    <issuedBy rdf:resource="urn:sema:resource:entity-029"/>
    <generalDescription xml:lang="ko">본 매뉴얼은 서울시립 미술아카이브의 기술 담당자에게 실무 매뉴얼을 제공하여 등록메타데이터의 일관성과 통일성을 제공한다. 본 매뉴얼에 따라서 작성된 등록메타데이터는 소장자료를 이용하는 모든 이용자가 원하는 자료를 찾고, 해당 자료의 의미를 이해할 수 있도록 지원한다.</generalDescription>
    <history xml:lang="ko">2022년 12월 20일에 발행되었다.</history>
    <hasOrHadRuleType xml:lang="ko">시립미술아카이브 매뉴얼</hasOrHadRuleType>
  </rdf:Description>
