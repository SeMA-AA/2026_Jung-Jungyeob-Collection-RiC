  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRelatedTo"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasSubjectOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordResource"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Connects a Record Resource to a Thing that is or was its
         subject.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour sujet</rdfs:label>
    <rdfs:label xml:lang="en">has or had subject</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como materia</rdfs:label>
    <skos:changeNote rdf:nodeID="N28876d7b7ddd4bcb83d00bc3b838e3f0"/>
    <skos:changeNote rdf:nodeID="N343cc85dfbbc477b90a5107716b05509"/>
    <skos:changeNote rdf:nodeID="N2292a021e6b64123909e265d292b9422"/>
    <skos:changeNote rdf:nodeID="N87702042f5cf49198964efb30b6c0b36"/>
    <skos:scopeNote xml:lang="en">The subject of a Record Set may be affected if the Record Set
         loses some of the Records.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R019 ('has or had subject'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:isOrganicOrFunctionalProvenanceOf">
