  <rdf:Description rdf:about="urn:sema:ontology:PositionToGroupRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N528a1f916d0b4704b21817bb6f9acebf"/>
