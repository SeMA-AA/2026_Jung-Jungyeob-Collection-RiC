    <skos:changeNote rdf:nodeID="N3e1fd7ac7b0b4694a267c04c915ba068"/>
    <skos:scopeNote xml:lang="en">The secondary entity may be, for instance, a Position or a Role
         Type.</skos:scopeNote>
  </rdf:Description>
