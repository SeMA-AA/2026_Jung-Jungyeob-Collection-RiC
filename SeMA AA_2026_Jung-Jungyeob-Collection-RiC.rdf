  <rdf:Description rdf:nodeID="Ne030c5ef1dc74992bfeb75ef6f3a70fb">
    <dc:date>2021-01-22</dc:date>
    <rdf:value xml:lang="en">changed the IRI, label, inverse property IRI, text definition,
               corresponding CM component name (changed made in order to make RiC-O compliant with
               RiC-CM 0.2; the name of this property in RiC-O 0.1 was "expresses").</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:hasDirectSubevent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
