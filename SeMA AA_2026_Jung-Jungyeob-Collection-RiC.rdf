  <rdf:Description rdf:about="urn:sema:resource:entity-008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:label xml:lang="ko">정정엽 컬렉션 실물</rdfs:label>
    <identifier>sample-entity-008</identifier>
    <identifier>C11</identifier>
    <name xml:lang="ko">정정엽 컬렉션 실물</name>
    <type xml:lang="ko">인스턴스</type>
    <isOrWasInstantiationOf rdf:resource="urn:sema:resource:entity-002"/>
    <generalDescription xml:lang="ko">정정엽 컬렉션의 비전자 자료로 구성된 물리적 구현체이다. 문서·사진·도서간행물·박물·홍보인쇄물 등 다양한 형태의 자료로 구성되어 있다.</generalDescription>
    <carrierExtent xml:lang="ko">보존상자 11개 및 박물류 자료</carrierExtent>
    <hasCarrierType xml:lang="ko">물리적</hasCarrierType>
    <conditionsOfAccess xml:lang="ko">부분공개</conditionsOfAccess>
    <conditionsOfUse xml:lang="ko">「서울시립 미술아카이브 공개 및 열람 규정」에 따라 열람이 가능하다.</conditionsOfUse>
    <history xml:lang="ko">2019년 수집 후 정리·등록되어 아트아카이브 보존서고에 배치·관리되고 있다.</history>
    <physicalCharacteristicsNote xml:lang="ko">도서간행물, 문서, 사진, 음성영상, 박물, 홍보인쇄물 등 다양한 물리적 형태로 구성되어 있다.</physicalCharacteristicsNote>
    <structure xml:lang="ko">비전자 자료는 아카이브의 물리적 형태에 따라 정리되어 있으며, 3-P-0001, 3-R-0012부터 3-R-0019, 4-M-0006, 4-M-0008 총 11개 보존상자와 박물류 서고에 배치되어 있다.</structure>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:accruals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordSet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment xml:lang="en">Information on the anticipated accession(s) to the Record
         Set.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">accroissements</rdfs:label>
    <rdfs:label xml:lang="en">accruals</rdfs:label>
    <rdfs:label xml:lang="es">ingresos</rdfs:label>
    <skos:changeNote rdf:nodeID="N0a276d2718fe48d4a2eac31306722b86"/>
    <skos:changeNote rdf:nodeID="Nfeff5825b7ff406c99176c6e2b28197d"/>
    <skos:changeNote rdf:nodeID="N97dd95b2b6704ac2b218e53f4b22deeb"/>
    <skos:example xml:lang="en">Accruing - there is an agreement with the creator that additional
         snapshots of their email directory will be accessioned at yearly intervals</skos:example>
    <skos:example xml:lang="en">Non-accruing</skos:example>
    <skos:example xml:lang="en">Unknown</skos:example>
    <skos:scopeNote xml:lang="en">See also accrualsStatus</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">corresponds to RiC-A01 (Accruals
         attribute)</RiCCMCorrespondingComponent>
  </rdf:Description>
