  <rdf:Description rdf:about="urn:sema:ontology:Date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="urn:sema:ontology:Thing"/>
    <rdfs:comment xml:lang="en">Chronological information associated with an entity that
         contributes to its identification and contextualization.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="en">Date</rdfs:label>
    <rdfs:label xml:lang="fr">Date</rdfs:label>
    <rdfs:label xml:lang="de">Datum</rdfs:label>
    <rdfs:label xml:lang="es">Fecha</rdfs:label>
    <skos:changeNote rdf:nodeID="N9fd0670f40cb45e795da16d673f5c674"/>
    <skos:changeNote rdf:nodeID="N115cf8d060d0455aba1a6383589de14d"/>
    <skos:changeNote rdf:nodeID="N48cb9813c9724e19acf25ad9aafc6233"/>
    <skos:changeNote rdf:nodeID="Nc07e8697a2d1467783e002b30aef95ea"/>
    <skos:changeNote rdf:nodeID="N858f8c8013c144f5ade104a58ea938d3"/>
    <skos:scopeNote xml:lang="en">A Date may be represented in natural language, based on a
         digital standard, or both. Digital standard dates will typically be based on ISO 8601, or
         Extended Date-Time Format (EDTF)</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Corresponds to RiC-E18 (Date
         entity)</RiCCMCorrespondingComponent>
  </rdf:Description>
