    <rdfs:label xml:lang="en">Performance Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación de desarrollo funcional</rdfs:label>
    <rdfs:label xml:lang="fr">Relation entre activités et agents</rdfs:label>
    <skos:changeNote rdf:nodeID="Ne1ebe3a2a4204a579425d18ff791945d"/>
    <skos:changeNote rdf:nodeID="N7262faf0700b4eebb1ffa13fca50bb83"/>
    <skos:changeNote rdf:nodeID="Nb394bb1d78364810ae51bc057d7ead55"/>
    <skos:changeNote rdf:nodeID="N236c07f9d9cc4b898be4e0760b3f7490"/>
