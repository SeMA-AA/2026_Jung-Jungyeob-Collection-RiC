    <type xml:lang="ko">업무</type>
    <hasTarget rdf:resource="urn:sema:resource:entity-002"/>
    <usesOrUsed rdf:resource="urn:sema:resource:entity-033"/>
    <generalDescription xml:lang="ko">서울시립 미술아카이브가 소장자료의 내용을 이용자에게 “디지털미술아카이브”를 통해 제공하는 활동이다.</generalDescription>
    <history xml:lang="ko">공개는 서울시립 미술아카이브가 소장자료의 내용을 디지털미술아카이브를 통해 이용자에게 제공하는 활동이다. 박물관과 소속 시기에는 공개에 관한 별도의 정책이 확정되지 않았으며, 2022년 8월 19일 서울시립미술관으로 편입된 이후 2023년 3월 8일 서울시립 미술아카이브 공개 및 열람 규정이 제정되었다. 2023년 4월 4일 서울시립 미술아카이브 개관과 동시에 디지털미술아카이브를 정식 오픈하여 이 규정에 근거하여 공개를 수행하고 있다. 이 규정은 2023년 8월 28일에 개정되었다.</history>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:ownershipRelation_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:authorityRelation_role"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:OwnershipRelation"/>
    <rdfs:range rdf:resource="urn:sema:ontology:OwnershipRelation"/>
    <rdfs:comment xml:lang="en">Connects an OwnershipRelation to itself. It is a property that can
         stand for an instance of the class when necessary, e.g. when you explore a knowledge
         graph.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a le rôle de la Relation de propriété</rdfs:label>
    <rdfs:label xml:lang="es">desempeña el papel de la Relación de posesión</rdfs:label>
    <rdfs:label xml:lang="en">has the role of the Ownership Relation</rdfs:label>
    <skos:changeNote rdf:nodeID="N77c82a3f242143aab1ab2d6890ba91a1"/>
    <skos:changeNote rdf:nodeID="N0313c2690ebf47c39eca991cd2e57593"/>
    <skos:scopeNote xml:lang="en">This property "rolifies" the OwnershipRelation class. It should
         be used only when you have to manage instances of the OwnershipRelation class, to connect
         each instance to itself, in order to be able to infer, using OWL-RL and property paths, the
         two shortcuts corresponding to this n-ary class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb593c1c65ace4345baeabf1245a79968">
    <dc:date>2023-11-25</dc:date>
    <rdf:value xml:lang="en">Added a new rdfs:label in Spanish.</rdf:value>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:hasOrHadDigitalInstantiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:hasOrHadInstantiation"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isOrWasDigitalInstantiationOf"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:RecordResource"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Instantiation"/>
    <rdfs:comment xml:lang="en">Connects a record resource to one of its digital instantiations,
         whether it exists or has been lost or destroyed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="fr">a ou a eu pour instanciation numérique</rdfs:label>
    <rdfs:label xml:lang="en">has or had digital instantiation</rdfs:label>
    <rdfs:label xml:lang="es">tiene o tenía como instanciación digital</rdfs:label>
    <skos:changeNote rdf:nodeID="Nde1fffee13484898a55b1cdc49e0a5f0"/>
    <skos:changeNote rdf:nodeID="Nd6b2fd3d3a5343a2843b52f0ff8de3d1"/>
    <skos:scopeNote xml:lang="en">This property can be used, among other cases, when you want to
         convert findings aids encoded in EAD/XML and need a simple and accurate migration path to
         process dao or daogrp EAD elements. Also, in some situations, it may be useful or necessary
         to connect a record resource to a digital instantiation that no longer exists or or has
         been lost.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:isEventAssociatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:isRelatedTo"/>
    <owl:inverseOf rdf:resource="urn:sema:ontology:isAssociatedWithEvent"/>
    <rdfs:domain rdf:resource="urn:sema:ontology:Event"/>
    <rdfs:range rdf:resource="urn:sema:ontology:Thing"/>
    <owl:propertyChainAxiom rdf:nodeID="Nea78ab3f5a824ce9a8e0731c53878cde"/>
    <rdfs:comment xml:lang="en">Connects an Event to a Thing that is associated with the existence
         and lifecycle of the Event.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="urn:sema:ontology"/>
    <rdfs:label xml:lang="es">es evento asociado con</rdfs:label>
    <rdfs:label xml:lang="fr">est un événement associé a</rdfs:label>
    <rdfs:label xml:lang="en">is event associated with</rdfs:label>
    <skos:changeNote rdf:nodeID="N01d4b10b0fc54373b43222a33ce3eb6b"/>
    <skos:changeNote rdf:nodeID="Nc4e6be8e21cc4435aafca6dded9bb32b"/>
    <skos:changeNote rdf:nodeID="N85f0bf4c52974c59b3e97fbbf9d46d98"/>
    <skos:changeNote rdf:nodeID="N4da509ef272e48b58f94156023cea5be"/>
    <skos:scopeNote xml:lang="en">Use to connect an Event and an entity only if it is not possible
         to specify a narrower Event relation, for example has or had participant.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R057 ('is event associated with'
         relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
