    <skos:changeNote rdf:nodeID="N942cf3f602cd4d54afaa9795ddc566ba"/>
    <RiCCMCorrespondingComponent xml:lang="en">RiC-R081 ('is or was creation date of all members
         of' relation)</RiCCMCorrespondingComponent>
  </rdf:Description>
