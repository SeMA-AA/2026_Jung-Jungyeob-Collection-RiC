  <rdf:Description rdf:about="urn:sema:ontology:LeadershipRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N783528760b31433ebbfdf4ac9103795b"/>
