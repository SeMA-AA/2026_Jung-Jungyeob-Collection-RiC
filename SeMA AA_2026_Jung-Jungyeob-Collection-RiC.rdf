    <hasOrHadJurisdiction rdf:resource="urn:sema:resource:entity-049"/>
    <organizesOrOrganized rdf:resource="urn:sema:resource:entity-042"/>
    <generalDescription xml:lang="ko">박물관과 산하 평창동미술문화복합추진반이 2022.8까지 있었다.</generalDescription>
    <history xml:lang="ko">문화본부 산하 문화시설추진단 소속 부서였다가, 한시조직인 문화시설추진단이 없어지고(2022.8) 문화본부 소속 부서로 변경되었다.</history>
    <hasOrHadLanguage xml:lang="ko">한국어</hasOrHadLanguage>
    <hasOrHadLegalStatus xml:lang="ko">지방자치단체 행정기구</hasOrHadLegalStatus>
