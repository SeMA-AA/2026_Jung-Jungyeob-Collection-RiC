    <skos:changeNote rdf:nodeID="N2d3e5d810e7f46bbbbc879246f3d1dd9"/>
    <skos:changeNote rdf:nodeID="N6660c36661d841bea608b3ca7af62f01"/>
    <skos:scopeNote xml:lang="en">The relation implies that the two persons met or at least
         corresponded with each other.</skos:scopeNote>
    <RiCCMCorrespondingComponent xml:lang="en">Class implementation of RiC-R051 and RiC—R051i
         relations</RiCCMCorrespondingComponent>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sema:ontology:asConcernsActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="urn:sema:ontology:relationHasContext"/>
